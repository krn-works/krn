{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krn.exposure/v1",
  "title": "krn.exposure/v1: one line of .krn/brain/exposures.jsonl",
  "type": "object",
  "required": [
    "schema",
    "at",
    "run",
    "task",
    "channel",
    "attempt",
    "served",
    "withheld",
    "tokens",
    "violated",
    "outcome",
    "lane_ok"
  ],
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "type": ["string", "null"]
    },
    "channel": {
      "type": "string",
      "minLength": 1
    },
    "served": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "withheld": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": {
        "enum": ["followed", "violated"]
      }
    },
    "lane_ok": {
      "type": "boolean"
    },
    "scope": {
      "type": "string"
    },
    "proof": {
      "type": "string"
    },
    "schema": {
      "enum": ["krn.exposure/v1"]
    },
    "at": {
      "type": "string"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "tokens": {
      "type": "integer",
      "minimum": 0
    },
    "violated": {
      "type": "object",
      "additionalProperties": {
        "type": ["boolean", "null"]
      }
    }
  }
}
