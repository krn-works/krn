{
  "version": 2,
  "checks": [
    {
      "id": "typecheck",
      "argv": ["npm", "run", "check"],
      "timeoutMs": 600000
    },
    {
      "id": "lint",
      "argv": ["npm", "run", "lint"],
      "timeoutMs": 600000
    },
    {
      "id": "rules",
      "argv": ["npm", "run", "rules"],
      "timeoutMs": 600000
    }
  ],
  "protected": [
    "scripts/**",
    "tsconfig.json",
    "biome.json",
    "spec/rules.json",
    "test/helpers/**",
    "test/**",
    "evals/woz/**"
  ]
}
