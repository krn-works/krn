+++ b/test/cli/count-lines.test.ts
@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { countLines } from '../../src/cli/count-lines.ts';
+
+test('countLines returns 0 for empty text', () => {
+  assert.equal(countLines(''), 0);
+});
+
+test('countLines counts text without a trailing newline', () => {
+  assert.equal(countLines('a'), 1);
+  assert.equal(countLines('a\nb'), 2);
+});
+
+test('countLines ignores a single trailing newline', () => {
+  assert.equal(countLines('a\n'), 1);
+  assert.equal(countLines('a\nb\n'), 2);
+});
+
+test('countLines counts blank lines', () => {
+  assert.equal(countLines('\n'), 1);
+  assert.equal(countLines('a\n\n'), 2);
+});
