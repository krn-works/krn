+/** Counts lines in text; a trailing newline does not start an extra line. */
+export function countLines(text: string): number {
+  if (text === '') return 0;
+  const newlines = text.split('\n').length - 1;
+  return text.endsWith('\n') ? newlines : newlines + 1;
+}
diff --git a/test/cli/count-lines.test.ts b/test/cli/count-lines.test.ts
