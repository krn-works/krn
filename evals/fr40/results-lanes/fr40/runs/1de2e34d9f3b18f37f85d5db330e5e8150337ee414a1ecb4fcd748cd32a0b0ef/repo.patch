new file mode 100644
index 0000000..3451868
--- /dev/null
+++ b/src/cli/median.ts
@@ -0,0 +1,9 @@
+/** Returns the median of `values`; throws a RangeError for an empty list. */
+export function median(values: readonly number[]): number {
+  if (values.length === 0) throw new RangeError('median of an empty list');
+  const sorted = [...values].sort((a, b) => a - b);
+  const mid = sorted.length >> 1;
+  return sorted.length % 2 === 1
+    ? (sorted[mid] as number)
+    : ((sorted[mid - 1] as number) + (sorted[mid] as number)) / 2;
+}
diff --git a/test/cli/median.test.ts b/test/cli/median.test.ts
new file mode 100644
