@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseFlag } from '../../src/cli/env-flag.ts';
+
+test('parseFlag accepts 1/true/yes/on case-insensitively', () => {
+  for (const v of ['1', 'true', 'TRUE', 'Yes', 'yEs', 'on', 'ON', ' on ']) {
+    assert.equal(parseFlag(v), true, v);
+  }
+});
+
+test('parseFlag rejects everything else', () => {
+  for (const v of [undefined, '', '0', 'false', 'no', 'off', '2', 'truthy']) {
+    assert.equal(parseFlag(v), false, String(v));
+  }
+});
