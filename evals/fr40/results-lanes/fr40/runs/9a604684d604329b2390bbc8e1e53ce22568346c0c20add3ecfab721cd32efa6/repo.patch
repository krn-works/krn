@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { wrapText } from '../../src/cli/wrap.ts';
+
+test('wrapText fills each line up to the width', () => {
+  assert.deepEqual(wrapText('the quick brown fox', 9), [
+    'the quick',
+    'brown fox',
+  ]);
+});
+
+test('wrapText keeps words shorter than the width whole', () => {
+  assert.deepEqual(wrapText('aaaa bbbb cccc', 5), ['aaaa', 'bbbb', 'cccc']);
+});
+
+test('wrapText splits only a word longer than the width', () => {
+  assert.deepEqual(wrapText('ab abcdefg', 3), ['ab', 'abc', 'def', 'g']);
+});
+
+test('wrapText returns no lines for blank text', () => {
+  assert.deepEqual(wrapText('  \n ', 10), []);
+});
