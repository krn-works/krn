new file mode 100644
index 0000000..c410ff6
--- /dev/null
+++ b/src/cli/retry.ts
@@ -0,0 +1,12 @@
+const MAX_DELAY_MS = 30_000;
+
+export function backoffDelays(attempts: number, baseMs: number): number[] {
+  const count = Number.isFinite(attempts)
+    ? Math.max(0, Math.floor(attempts))
+    : 0;
+  const delays: number[] = [];
+  for (let attempt = 0; attempt < count; attempt += 1) {
+    delays.push(Math.min(baseMs * 2 ** attempt, MAX_DELAY_MS));
+  }
+  return delays;
+}
diff --git a/test/cli/retry.test.ts b/test/cli/retry.test.ts
