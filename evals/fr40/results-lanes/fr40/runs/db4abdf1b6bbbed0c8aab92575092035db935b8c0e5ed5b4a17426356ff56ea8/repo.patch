+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { dedupeBy } from '../../src/cli/dedupe.ts';
+
+test('keeps the first item per key in original order', () => {
+  const items = [
+    { id: 'a', n: 1 },
+    { id: 'b', n: 2 },
+    { id: 'a', n: 3 },
+    { id: 'c', n: 4 },
+    { id: 'b', n: 5 },
+  ];
+  assert.deepEqual(
+    dedupeBy(items, (i) => i.id),
+    [items[0], items[1], items[3]],
+  );
+});
+
+test('returns an empty array for empty input', () => {
+  assert.deepEqual(
+    dedupeBy([], (i) => String(i)),
+    [],
+  );
+});
+
+test('does not mutate the input and returns a new array', () => {
+  const items = ['x', 'x', 'y'] as const;
+  const out = dedupeBy(items, (s) => s);
+  assert.deepEqual(items, ['x', 'x', 'y']);
+  assert.notEqual(out, items);
+  assert.deepEqual(out, ['x', 'y']);
+});
