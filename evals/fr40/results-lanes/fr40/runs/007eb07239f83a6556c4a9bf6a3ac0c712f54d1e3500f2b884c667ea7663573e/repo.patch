@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { truncateMiddle } from '../../src/cli/truncate.ts';
+
+test('text within the limit is returned unchanged', () => {
+  assert.equal(truncateMiddle('abcde', 5), 'abcde');
+});
+
+test('long text keeps both ends around an ellipsis', () => {
+  assert.equal(truncateMiddle('abcdefghij', 5), 'ab…ij');
+  assert.equal(truncateMiddle('abcdefghij', 6), 'abc…ij');
+});
+
+test('result never exceeds the limit', () => {
+  for (let max = 0; max < 12; max++) {
+    assert.ok(
+      Array.from(truncateMiddle('abcdefghijklmnop', max)).length <= max,
+    );
+  }
+});
+
+test('a non-positive limit yields an empty string', () => {
+  assert.equal(truncateMiddle('abc', 0), '');
+});
