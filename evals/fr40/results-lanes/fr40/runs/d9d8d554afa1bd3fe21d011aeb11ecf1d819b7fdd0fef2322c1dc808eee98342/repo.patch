+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { truncateMiddle } from '../../src/core/truncate.ts';
+
+test('truncateMiddle returns short text unchanged', () => {
+  assert.equal(truncateMiddle('abcdef', 6), 'abcdef');
+  assert.equal(truncateMiddle('', 3), '');
+});
+
+test('truncateMiddle keeps both ends around an ellipsis', () => {
+  assert.equal(truncateMiddle('abcdefghij', 5), 'ab…ij');
+  assert.equal(truncateMiddle('abcdefghij', 6), 'abc…ij');
+});
+
+test('truncateMiddle handles tiny budgets', () => {
+  assert.equal(truncateMiddle('abcdef', 1), '…');
+  assert.equal(truncateMiddle('abcdef', 0), '');
+  assert.equal(truncateMiddle('abcdef', 2), 'a…');
+});
+
+test('truncateMiddle never splits an astral character', () => {
+  const result = truncateMiddle('😀😀😀😀😀😀', 4);
+  assert.equal(result, '😀😀…😀');
+  assert.ok(result.isWellFormed());
+});
