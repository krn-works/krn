@@ -0,0 +1,17 @@
+const ellipsis = '…';
+
+// Keeps both ends of text around an ellipsis so the result has at most max
+// code points; the head gets the extra one when the budget is odd.
+export function truncateMiddle(text: string, max: number): string {
+  const characters = Array.from(text);
+  if (characters.length <= max) return text;
+  if (max <= 0) return '';
+  if (max === 1) return ellipsis;
+  const keep = max - 1;
+  const tail = Math.floor(keep / 2);
+  return (
+    characters.slice(0, keep - tail).join('') +
+    ellipsis +
+    characters.slice(characters.length - tail).join('')
+  );
+}
