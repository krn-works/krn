+/**
+ * Word-wraps `text` to lines of at most `width` characters. Words shorter than
+ * the width are never split; words that cannot fit on a line are hard-split.
+ */
+export function wrapText(text: string, width: number): string[] {
+  if (!Number.isInteger(width) || width < 1) {
+    throw new RangeError('width must be a positive integer');
+  }
+  const lines: string[] = [];
+  let line = '';
+  for (const word of text.split(/\s+/).filter((w) => w !== '')) {
+    if (line !== '' && line.length + 1 + word.length <= width) {
+      line += ` ${word}`;
+      continue;
+    }
+    if (line !== '') lines.push(line);
+    let rest = word;
+    while (rest.length > width) {
+      lines.push(rest.slice(0, width));
+      rest = rest.slice(width);
+    }
+    line = rest;
+  }
+  if (line !== '') lines.push(line);
+  return lines;
+}
diff --git a/test/cli/wrap.test.ts b/test/cli/wrap.test.ts
new file mode 100644
index 0000000..37bd5e7
--- /dev/null
+++ b/test/cli/wrap.test.ts
@@ -0,0 +1,27 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { wrapText } from '../../src/cli/wrap.ts';
+
+test('wraps at word boundaries', () => {
+  assert.deepEqual(wrapText('the quick brown fox', 9), [
+    'the quick',
+    'brown fox',
+  ]);
+});
+
+test('keeps words shorter than width whole', () => {
+  assert.deepEqual(wrapText('aaaa bbbb cccc', 6), ['aaaa', 'bbbb', 'cccc']);
+});
+
+test('hard-splits words longer than width', () => {
+  assert.deepEqual(wrapText('abcdefg hi', 3), ['abc', 'def', 'g', 'hi']);
+});
+
+test('collapses whitespace and handles empty text', () => {
+  assert.deepEqual(wrapText('  a   b ', 10), ['a b']);
+  assert.deepEqual(wrapText('', 10), []);
+});
+
+test('rejects invalid width', () => {
+  assert.throws(() => wrapText('a', 0), RangeError);
+});
