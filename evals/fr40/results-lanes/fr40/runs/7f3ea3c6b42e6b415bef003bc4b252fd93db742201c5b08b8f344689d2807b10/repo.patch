--- /dev/null
+++ b/test/cli/env-flag.test.ts
@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseFlag } from '../../src/cli/env-flag.ts';
+
+test('parse flag accepts 1, true, yes and on in any case', () => {
+  for (const value of ['1', 'true', 'TRUE', 'Yes', 'on', 'ON']) {
+    assert.equal(parseFlag(value), true, value);
+  }
+});
+
+test('parse flag rejects other values and undefined', () => {
+  for (const value of [undefined, '', '0', 'false', 'no', 'off', 'maybe']) {
+    assert.equal(parseFlag(value), false, String(value));
+  }
+});
