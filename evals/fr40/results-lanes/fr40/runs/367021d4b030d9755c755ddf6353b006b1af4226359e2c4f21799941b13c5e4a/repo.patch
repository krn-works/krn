+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderTable } from '../../src/cli/table.ts';
+
+test('renderTable pads columns to equal width', () => {
+  assert.equal(
+    renderTable([
+      ['name', 'id'],
+      ['alpha', '1'],
+      ['b', '22'],
+    ]),
+    ['name   id', 'alpha  1', 'b      22'].join('\n'),
+  );
+});
+
+test('renderTable handles no rows and ragged rows', () => {
+  assert.equal(renderTable([]), '');
+  assert.equal(renderTable([['a', 'b', 'c'], ['dddd']]), 'a     b  c\ndddd');
+});
