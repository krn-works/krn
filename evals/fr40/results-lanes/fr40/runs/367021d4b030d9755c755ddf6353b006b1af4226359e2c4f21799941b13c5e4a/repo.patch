new file mode 100644
index 0000000..745d3fb
--- /dev/null
+++ b/src/cli/table.ts
@@ -0,0 +1,21 @@
+/**
+ * Renders rows as a text table: every column is padded to its widest cell and
+ * columns are separated by two spaces. The last column is not padded, so lines
+ * carry no trailing whitespace. Missing cells in short rows render as empty.
+ */
+export function renderTable(rows: readonly string[][]): string {
+  const columns = Math.max(0, ...rows.map((row) => row.length));
+  const widths: number[] = [];
+  for (let c = 0; c < columns; c++) {
+    widths.push(Math.max(...rows.map((row) => (row[c] ?? '').length)));
+  }
+  return rows
+    .map((row) =>
+      row
+        .map((cell, c) =>
+          c === row.length - 1 ? cell : cell.padEnd(widths[c] ?? 0),
+        )
+        .join('  '),
+    )
+    .join('\n');
+}
