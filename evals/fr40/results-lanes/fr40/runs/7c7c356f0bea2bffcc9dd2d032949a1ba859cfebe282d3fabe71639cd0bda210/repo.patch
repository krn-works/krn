+++ b/test/core/count-lines.test.ts
@@ -0,0 +1,17 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { countLines } from '../../src/core/count-lines.ts';
+
+test('empty text has no lines', () => {
+  assert.equal(countLines(''), 0);
+});
+
+test('a trailing newline adds no extra line', () => {
+  assert.equal(countLines('a\nb\n'), 2);
+  assert.equal(countLines('a\nb'), 2);
+});
+
+test('blank lines count', () => {
+  assert.equal(countLines('\n'), 1);
+  assert.equal(countLines('a\n\nb'), 3);
+});
