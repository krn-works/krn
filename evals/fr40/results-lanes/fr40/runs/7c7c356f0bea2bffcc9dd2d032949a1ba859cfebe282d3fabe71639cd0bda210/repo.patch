+++ b/src/core/count-lines.ts
@@ -0,0 +1,5 @@
+export function countLines(text: string): number {
+  if (text === '') return 0;
+  const breaks = text.split('\n').length - 1;
+  return text.endsWith('\n') ? breaks : breaks + 1;
+}
diff --git a/test/core/count-lines.test.ts b/test/core/count-lines.test.ts
