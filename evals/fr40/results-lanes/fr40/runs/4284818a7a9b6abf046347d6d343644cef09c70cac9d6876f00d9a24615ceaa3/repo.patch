new file mode 100644
index 0000000..be238d9
--- /dev/null
+++ b/src/cli/bytes.ts
@@ -0,0 +1,19 @@
+const UNITS = ['B', 'KiB', 'MiB', 'GiB'] as const;
+
+/**
+ * Renders a byte count with the largest fitting unit (B, KiB, MiB or GiB) and
+ * one decimal, e.g. `1536` becomes `1.5 KiB`. Counts of 1024 GiB or more stay
+ * in GiB. Rejects negative and non-finite counts.
+ */
+export function formatBytes(n: number): string {
+  if (!Number.isFinite(n) || n < 0) {
+    throw new RangeError(`byte count must be a finite number >= 0: ${n}`);
+  }
+  let unit = 0;
+  let value = n;
+  while (unit < UNITS.length - 1 && Math.round(value * 10) / 10 >= 1024) {
+    value /= 1024;
+    unit++;
+  }
+  return `${value.toFixed(1)} ${UNITS[unit]}`;
+}
diff --git a/test/cli/bytes.test.ts b/test/cli/bytes.test.ts
new file mode 100644
index 0000000..e40965f
--- /dev/null
+++ b/test/cli/bytes.test.ts
@@ -0,0 +1,29 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { formatBytes } from '../../src/cli/bytes.ts';
+
+test('formats small counts in bytes with one decimal', () => {
+  assert.equal(formatBytes(0), '0.0 B');
+  assert.equal(formatBytes(1023), '1023.0 B');
+});
+
+test('switches unit at each power of 1024', () => {
+  assert.equal(formatBytes(1024), '1.0 KiB');
+  assert.equal(formatBytes(1536), '1.5 KiB');
+  assert.equal(formatBytes(1024 ** 2), '1.0 MiB');
+  assert.equal(formatBytes(1024 ** 3), '1.0 GiB');
+});
+
+test('promotes a value that would round up to 1024', () => {
+  assert.equal(formatBytes(1024 ** 2 - 1), '1.0 MiB');
+});
+
+test('keeps very large counts in GiB', () => {
+  assert.equal(formatBytes(2048 * 1024 ** 3), '2048.0 GiB');
+});
+
+test('rejects negative and non-finite counts', () => {
+  assert.throws(() => formatBytes(-1), RangeError);
+  assert.throws(() => formatBytes(Number.NaN), RangeError);
+  assert.throws(() => formatBytes(Number.POSITIVE_INFINITY), RangeError);
+});
