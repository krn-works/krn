@@ -0,0 +1,17 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { maskSecret } from '../../src/core/mask.ts';
+
+test('keeps the last four characters', () => {
+  assert.equal(maskSecret('abcdef1234'), '******1234');
+});
+
+test('fully stars short values', () => {
+  assert.equal(maskSecret('abcd'), '****');
+  assert.equal(maskSecret('ab'), '**');
+  assert.equal(maskSecret(''), '');
+});
+
+test('masks a five character value', () => {
+  assert.equal(maskSecret('abcde'), '*bcde');
+});
