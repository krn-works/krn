@@ -0,0 +1,5 @@
+/** Stars all but the last four characters; values of four or fewer are fully starred. */
+export const maskSecret = (value: string): string =>
+  value.length <= 4
+    ? '*'.repeat(value.length)
+    : value.slice(-4).padStart(value.length, '*');
diff --git a/test/core/mask.test.ts b/test/core/mask.test.ts
new file mode 100644
