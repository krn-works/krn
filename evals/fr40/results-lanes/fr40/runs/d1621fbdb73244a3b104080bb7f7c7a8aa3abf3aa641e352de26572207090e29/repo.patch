diff --git a/src/cli/percent.ts b/src/cli/percent.ts
new file mode 100644
index 0000000..53fc96b
--- /dev/null
+++ b/src/cli/percent.ts
@@ -0,0 +1,4 @@
+export function percent(part: number, total: number): string {
+  if (total === 0) return '0.0%';
+  return `${((part / total) * 100).toFixed(1)}%`;
+}
diff --git a/test/cli/percent.test.ts b/test/cli/percent.test.ts
new file mode 100644
index 0000000..1f52a59
