--- /dev/null
+++ b/test/core/group-by.test.ts
@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { groupBy } from '../../src/core/group-by.ts';
+
+test('groupBy keeps key and item input order', () => {
+  const groups = groupBy(['bb', 'a', 'cc', 'd', 'e'], (s) => String(s.length));
+  assert.deepEqual(
+    [...groups],
+    [
+      ['2', ['bb', 'cc']],
+      ['1', ['a', 'd', 'e']],
+    ],
+  );
+});
+
+test('groupBy returns an empty map for no items', () => {
+  assert.equal(groupBy([], String).size, 0);
+});
