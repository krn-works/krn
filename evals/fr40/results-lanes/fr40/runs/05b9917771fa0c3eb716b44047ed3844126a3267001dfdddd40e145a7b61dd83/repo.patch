@@ -0,0 +1,7 @@
+/** Groups items by key; keys and items within each group keep input order. */
+export function groupBy<T>(
+  items: readonly T[],
+  key: (item: T) => string,
+): Map<string, T[]> {
+  return Map.groupBy(items, key);
+}
diff --git a/test/core/group-by.test.ts b/test/core/group-by.test.ts
new file mode 100644
