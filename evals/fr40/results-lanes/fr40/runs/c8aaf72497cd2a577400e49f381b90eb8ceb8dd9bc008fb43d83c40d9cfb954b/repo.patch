@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { median } from '../../src/cli/median.ts';
+
+test('median returns the middle value of an odd-length list', () => {
+  assert.equal(median([3, 1, 2]), 2);
+});
+
+test('median averages the two middle values of an even-length list', () => {
+  assert.equal(median([4, 1, 3, 2]), 2.5);
+});
+
+test('median does not mutate its input', () => {
+  const input = [3, 1, 2];
+  median(input);
+  assert.deepEqual(input, [3, 1, 2]);
+});
+
+test('median rejects an empty list', () => {
+  assert.throws(() => median([]), RangeError);
+});
