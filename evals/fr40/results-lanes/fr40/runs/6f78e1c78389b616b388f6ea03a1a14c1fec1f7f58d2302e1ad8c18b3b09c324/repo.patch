index 0000000..a000996
--- /dev/null
+++ b/src/cli/wrap.ts
@@ -0,0 +1,27 @@
+/**
+ * Word-wraps `text` into lines of at most `width` characters. Words that fit
+ * within the width are never split; a longer word is broken into `width`-sized
+ * pieces. Runs of whitespace collapse to a single space.
+ */
+export function wrapText(text: string, width: number): string[] {
+  if (!Number.isInteger(width) || width < 1) {
+    throw new RangeError(`wrap width must be a positive integer, got ${width}`);
+  }
+  const lines: string[] = [];
+  let line = '';
+  for (const word of text.split(/\s+/).filter((w) => w !== '')) {
+    if (line !== '' && line.length + 1 + word.length <= width) {
+      line += ` ${word}`;
+      continue;
+    }
+    if (line !== '') lines.push(line);
+    let rest = word;
+    while (rest.length > width) {
+      lines.push(rest.slice(0, width));
+      rest = rest.slice(width);
+    }
+    line = rest;
+  }
+  if (line !== '') lines.push(line);
+  return lines;
+}
diff --git a/test/cli/wrap.test.ts b/test/cli/wrap.test.ts
new file mode 100644
index 0000000..1970e50
--- /dev/null
+++ b/test/cli/wrap.test.ts
@@ -0,0 +1,24 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { wrapText } from '../../src/cli/wrap.ts';
+
+test('wraps at word boundaries within the width', () => {
+  assert.deepEqual(wrapText('the quick brown fox', 9), ['the quick', 'brown fox']);
+});
+
+test('keeps a word that exactly fills the width intact', () => {
+  assert.deepEqual(wrapText('abc defgh ij', 5), ['abc', 'defgh', 'ij']);
+});
+
+test('collapses whitespace and returns no lines for empty text', () => {
+  assert.deepEqual(wrapText('a   b\n c', 10), ['a b c']);
+  assert.deepEqual(wrapText('  ', 10), []);
+});
+
+test('breaks only words longer than the width', () => {
+  assert.deepEqual(wrapText('ab abcdefg', 3), ['ab', 'abc', 'def', 'g']);
+});
+
+test('rejects a non-positive width', () => {
+  assert.throws(() => wrapText('a', 0), RangeError);
+});
