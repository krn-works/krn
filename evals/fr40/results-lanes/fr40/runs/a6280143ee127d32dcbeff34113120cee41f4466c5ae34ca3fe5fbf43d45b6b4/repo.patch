+++ b/test/cli/semver.test.ts
@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { compareVersions } from '../../src/cli/semver.ts';
+
+test('compareVersions orders numerically, not lexically', () => {
+  assert.equal(compareVersions('1.2.10', '1.2.9'), 1);
+  assert.equal(compareVersions('1.2.9', '1.2.10'), -1);
+  assert.equal(compareVersions('2.0.0', '10.0.0'), -1);
+});
+
+test('compareVersions treats missing parts as zero', () => {
+  assert.equal(compareVersions('1.2', '1.2.0'), 0);
+  assert.equal(compareVersions('1.2', '1.2.1'), -1);
+  assert.equal(compareVersions('1.3', '1.2.9'), 1);
+});
+
+test('compareVersions rejects non-numeric input', () => {
+  assert.throws(() => compareVersions('1.x', '1.0'), /Invalid/);
+  assert.throws(() => compareVersions('', '1.0'), /Invalid/);
+});
