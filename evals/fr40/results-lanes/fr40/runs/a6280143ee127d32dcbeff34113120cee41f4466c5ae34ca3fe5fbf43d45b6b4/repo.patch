@@ -0,0 +1,26 @@
+/**
+ * Orders dotted numeric versions such as `1.2.10`. Returns a negative number
+ * when `a` < `b`, positive when `a` > `b`, and 0 when equal. Missing parts
+ * count as 0, so `1.2` equals `1.2.0`.
+ */
+export function compareVersions(a: string, b: string): number {
+  const left = parse(a);
+  const right = parse(b);
+  const length = Math.max(left.length, right.length);
+  for (let i = 0; i < length; i++) {
+    const diff = (left[i] ?? 0) - (right[i] ?? 0);
+    if (diff !== 0) return diff < 0 ? -1 : 1;
+  }
+  return 0;
+}
+
+function parse(version: string): number[] {
+  return version.split('.').map((part) => {
+    if (!/^\d+$/.test(part)) {
+      throw new Error(
+        `Invalid dotted numeric version: ${JSON.stringify(version)}`,
+      );
+    }
+    return Number(part);
+  });
+}
diff --git a/test/cli/semver.test.ts b/test/cli/semver.test.ts
new file mode 100644
