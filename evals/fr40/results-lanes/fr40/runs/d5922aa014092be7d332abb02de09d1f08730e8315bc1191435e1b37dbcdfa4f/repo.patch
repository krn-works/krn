@@ -0,0 +1,25 @@
+/**
+ * Greedy word-wrap. Lines are at most `width` characters unless a single word
+ * is longer than `width`; such a word is hard-split into `width`-sized chunks.
+ * Words that fit within the width are never split. Whitespace runs collapse.
+ */
+export function wrapText(text: string, width: number): string[] {
+  const limit = Math.max(1, Math.floor(width));
+  const lines: string[] = [];
+  let line = '';
+  for (const word of text.split(/\s+/).filter(Boolean)) {
+    if (line && line.length + 1 + word.length <= limit) {
+      line += ` ${word}`;
+      continue;
+    }
+    if (line) lines.push(line);
+    let rest = word;
+    while (rest.length > limit) {
+      lines.push(rest.slice(0, limit));
+      rest = rest.slice(limit);
+    }
+    line = rest;
+  }
+  if (line) lines.push(line);
+  return lines;
+}
