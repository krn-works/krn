@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { wrapText } from '../../src/cli/wrap.ts';
+
+test('wraps greedily at word boundaries', () => {
+  assert.deepEqual(wrapText('the quick brown fox', 9), [
+    'the quick',
+    'brown fox',
+  ]);
+});
+
+test('keeps a word equal to the width whole', () => {
+  assert.deepEqual(wrapText('ab abcd ef', 4), ['ab', 'abcd', 'ef']);
+});
+
+test('collapses whitespace and returns no lines for empty text', () => {
+  assert.deepEqual(wrapText('  a \n b  ', 10), ['a b']);
+  assert.deepEqual(wrapText('   ', 10), []);
+});
+
+test('hard-splits only words longer than the width', () => {
+  assert.deepEqual(wrapText('a abcdefg b', 3), ['a', 'abc', 'def', 'g b']);
+});
