+++ b/test/cli/bytes.test.ts
@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { formatBytes } from '../../src/cli/bytes.ts';
+
+test('formatBytes renders bytes with one decimal', () => {
+  assert.equal(formatBytes(0), '0.0 B');
+  assert.equal(formatBytes(1023), '1023.0 B');
+});
+
+test('formatBytes steps through KiB, MiB and GiB', () => {
+  assert.equal(formatBytes(1024), '1.0 KiB');
+  assert.equal(formatBytes(1536), '1.5 KiB');
+  assert.equal(formatBytes(1024 ** 2), '1.0 MiB');
+  assert.equal(formatBytes(1024 ** 3), '1.0 GiB');
+});
+
+test('formatBytes stays in GiB for very large counts', () => {
+  assert.equal(formatBytes(2048 * 1024 ** 3), '2048.0 GiB');
+});
