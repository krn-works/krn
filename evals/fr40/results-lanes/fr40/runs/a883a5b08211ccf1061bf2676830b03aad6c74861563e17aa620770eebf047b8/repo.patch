@@ -0,0 +1,12 @@
+/** Keeps the first item for each key, preserving input order. */
+export function dedupeBy<T>(items: readonly T[], key: (item: T) => string): T[] {
+  const seen = new Set<string>();
+  const kept: T[] = [];
+  for (const item of items) {
+    const k = key(item);
+    if (seen.has(k)) continue;
+    seen.add(k);
+    kept.push(item);
+  }
+  return kept;
+}
