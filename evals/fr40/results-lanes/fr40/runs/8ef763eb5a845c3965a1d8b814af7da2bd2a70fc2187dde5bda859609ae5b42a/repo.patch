@@ -0,0 +1,12 @@
+/** Keeps the first item for each key, preserving input order. */
+export function dedupeBy<T>(
+  items: readonly T[],
+  key: (item: T) => string,
+): T[] {
+  const first = new Map<string, T>();
+  for (const item of items) {
+    const k = key(item);
+    if (!first.has(k)) first.set(k, item);
+  }
+  return [...first.values()];
+}
