@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { dedupeBy } from '../../src/core/dedupe.ts';
+
+test('dedupeBy keeps the first item per key in input order', () => {
+  const items = [
+    { id: 'a', n: 1 },
+    { id: 'b', n: 2 },
+    { id: 'a', n: 3 },
+  ];
+  assert.deepEqual(
+    dedupeBy(items, (i) => i.id),
+    [items[0], items[1]],
+  );
+});
+
+test('dedupeBy returns a new empty array for empty input', () => {
+  const input: string[] = [];
+  const out = dedupeBy(input, (s) => s);
+  assert.deepEqual(out, []);
+  assert.notEqual(out, input);
+});
