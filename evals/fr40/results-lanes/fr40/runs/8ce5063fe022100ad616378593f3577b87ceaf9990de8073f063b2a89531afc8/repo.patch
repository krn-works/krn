@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { parseRange } from '../../src/cli/range.ts';
+
+test('expands ranges and single values', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('accepts a single value and whitespace', () => {
+  assert.deepEqual(parseRange(' 4 '), [4]);
+  assert.deepEqual(parseRange('1, 2-3'), [1, 2, 3]);
+});
+
+test('rejects malformed or descending segments', () => {
+  assert.throws(() => parseRange('a'), /Invalid range/);
+  assert.throws(() => parseRange('3-1'), /Invalid range/);
+  assert.throws(() => parseRange(''), /Invalid range/);
+});
