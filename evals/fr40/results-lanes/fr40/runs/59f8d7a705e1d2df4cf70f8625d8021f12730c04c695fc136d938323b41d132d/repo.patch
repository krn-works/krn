--- /dev/null
+++ b/test/cli/group-by.test.ts
@@ -0,0 +1,14 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { groupBy } from '../../src/cli/group-by.ts';
+
+test('group by keeps input order within and across groups', () => {
+  const result = groupBy(['bb', 'a', 'cc', 'd', 'e'], (s) => String(s.length));
+  assert.deepEqual([...result.keys()], ['2', '1']);
+  assert.deepEqual(result.get('2'), ['bb', 'cc']);
+  assert.deepEqual(result.get('1'), ['a', 'd', 'e']);
+});
+
+test('group by returns an empty map for no items', () => {
+  assert.equal(groupBy([], (s: string) => s).size, 0);
+});
