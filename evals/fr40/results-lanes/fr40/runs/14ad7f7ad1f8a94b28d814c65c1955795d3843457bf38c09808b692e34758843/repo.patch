+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { dedupeBy } from '../../src/cli/dedupe.ts';
+
+test('dedupeBy keeps the first item per key in order', () => {
+  const items = [
+    { id: 'a', n: 1 },
+    { id: 'b', n: 2 },
+    { id: 'a', n: 3 },
+  ];
+  assert.deepEqual(
+    dedupeBy(items, (i) => i.id),
+    [
+      { id: 'a', n: 1 },
+      { id: 'b', n: 2 },
+    ],
+  );
+});
+
+test('dedupeBy handles empty input and does not mutate it', () => {
+  assert.deepEqual(dedupeBy([], String), []);
+  const items = ['x', 'x'];
+  dedupeBy(items, String);
+  assert.equal(items.length, 2);
+});
