+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { wrapText } from '../../src/cli/wrap.ts';
+
+test('wraps at word boundaries', () => {
+  assert.deepEqual(wrapText('the quick brown fox jumps', 10), [
+    'the quick',
+    'brown fox',
+    'jumps',
+  ]);
+});
+
+test('a word exactly the width stays whole', () => {
+  assert.deepEqual(wrapText('ab abcde fg', 5), ['ab', 'abcde', 'fg']);
+});
+
+test('does not split words shorter than the width', () => {
+  assert.deepEqual(wrapText('alpha beta gamma delta', 7), [
+    'alpha',
+    'beta',
+    'gamma',
+    'delta',
+  ]);
+});
+
+test('hard-splits only words longer than the width', () => {
+  assert.deepEqual(wrapText('a abcdefghij b', 4), [
+    'a',
+    'abcd',
+    'efgh',
+    'ij b',
+  ]);
+});
+
+test('collapses whitespace and handles empty input', () => {
+  assert.deepEqual(wrapText('  a \n\t b  ', 10), ['a b']);
+  assert.deepEqual(wrapText('', 10), []);
+  assert.deepEqual(wrapText('   ', 10), []);
+});
+
+test('rejects invalid widths', () => {
+  assert.throws(() => wrapText('a', 0), RangeError);
+  assert.throws(() => wrapText('a', 1.5), RangeError);
+});
