+/**
+ * Word-wraps `text` into lines of at most `width` characters. Words that fit
+ * within `width` are never split; only a word longer than `width` is broken
+ * into `width`-sized chunks. Runs of whitespace collapse to a single space.
+ */
+export function wrapText(text: string, width: number): string[] {
+  if (!Number.isInteger(width) || width < 1) {
+    throw new RangeError(`width must be a positive integer, got ${width}`);
+  }
+  const lines: string[] = [];
+  let line = '';
+  for (const word of text.split(/\s+/).filter((w) => w !== '')) {
+    if (line !== '' && line.length + 1 + word.length <= width) {
+      line += ` ${word}`;
+      continue;
+    }
+    if (line !== '') lines.push(line);
+    let rest = word;
+    while (rest.length > width) {
+      lines.push(rest.slice(0, width));
+      rest = rest.slice(width);
+    }
+    line = rest;
+  }
+  if (line !== '') lines.push(line);
+  return lines;
+}
