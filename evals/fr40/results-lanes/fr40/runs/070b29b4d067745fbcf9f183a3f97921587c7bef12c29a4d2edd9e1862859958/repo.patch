+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { groupBy } from '../../src/cli/group-by.ts';
+
+test('groupBy returns an empty map for empty input', () => {
+  assert.equal(groupBy([], String).size, 0);
+});
+
+test('groupBy keeps input order within groups and first-seen order of keys', () => {
+  const result = groupBy(
+    ['bb', 'a', 'cc', 'd', 'e', 'f'],
+    (s) => `len${s.length}`,
+  );
+  assert.deepEqual([...result.keys()], ['len2', 'len1']);
+  assert.deepEqual(result.get('len2'), ['bb', 'cc']);
+  assert.deepEqual(result.get('len1'), ['a', 'd', 'e', 'f']);
+});
+
+test('groupBy does not mutate input and passes items to key', () => {
+  const input = [{ id: 1 }, { id: 2 }] as const;
+  const seen: number[] = [];
+  groupBy(input, (i) => {
+    seen.push(i.id);
+    return 'x';
+  });
+  assert.deepEqual(seen, [1, 2]);
+  assert.equal(input.length, 2);
+});
+
+test('groupBy handles keys like __proto__', () => {
+  const result = groupBy(['a'], () => '__proto__');
+  assert.deepEqual(result.get('__proto__'), ['a']);
+});
