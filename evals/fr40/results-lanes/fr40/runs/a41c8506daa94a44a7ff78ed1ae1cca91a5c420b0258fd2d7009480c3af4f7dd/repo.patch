diff --git a/src/cli/plural.ts b/src/cli/plural.ts
new file mode 100644
index 0000000..0c5c15c
--- /dev/null
+++ b/src/cli/plural.ts
@@ -0,0 +1,4 @@
+/** Renders a count with its noun, adding an `s` unless the count is exactly 1. */
+export function plural(count: number, noun: string): string {
+  return `${count} ${count === 1 ? noun : `${noun}s`}`;
+}
