@@ -0,0 +1,17 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRange } from '../../src/cli/range.ts';
+
+test('range expands spans and single numbers', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('range accepts a single number and empty text', () => {
+  assert.deepEqual(parseRange('7'), [7]);
+  assert.deepEqual(parseRange(''), []);
+});
+
+test('range rejects malformed and descending segments', () => {
+  assert.throws(() => parseRange('a'), /invalid range/);
+  assert.throws(() => parseRange('3-1'), /descending/);
+});
