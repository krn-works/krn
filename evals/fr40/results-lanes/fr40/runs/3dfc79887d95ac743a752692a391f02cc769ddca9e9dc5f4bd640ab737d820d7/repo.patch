+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { formatDuration } from '../../src/cli/duration.ts';
+
+test('formatDuration drops zero leading units', () => {
+  assert.equal(formatDuration(0), '0s');
+  assert.equal(formatDuration(3000), '3s');
+  assert.equal(formatDuration(63000), '1m 3s');
+  assert.equal(formatDuration(3723000), '1h 2m 3s');
+  assert.equal(formatDuration(3600000), '1h 0m 0s');
+});
+
+test('formatDuration floors sub-second values and clamps negatives', () => {
+  assert.equal(formatDuration(999), '0s');
+  assert.equal(formatDuration(-5), '0s');
+});
