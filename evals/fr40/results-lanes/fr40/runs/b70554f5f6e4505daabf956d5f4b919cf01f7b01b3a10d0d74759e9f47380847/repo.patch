--- /dev/null
+++ b/test/core/bytes.test.ts
@@ -0,0 +1,16 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { formatBytes } from '../../src/core/bytes.ts';
+
+test('formatBytes renders each unit with one decimal', () => {
+  assert.equal(formatBytes(0), '0.0 B');
+  assert.equal(formatBytes(1023), '1023.0 B');
+  assert.equal(formatBytes(1024), '1.0 KiB');
+  assert.equal(formatBytes(1536), '1.5 KiB');
+  assert.equal(formatBytes(1024 ** 2), '1.0 MiB');
+  assert.equal(formatBytes(1024 ** 3), '1.0 GiB');
+});
+
+test('formatBytes keeps GiB for very large counts', () => {
+  assert.equal(formatBytes(1024 ** 4), '1024.0 GiB');
+});
