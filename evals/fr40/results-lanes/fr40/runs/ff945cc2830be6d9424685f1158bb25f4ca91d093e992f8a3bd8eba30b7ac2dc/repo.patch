--- /dev/null
+++ b/test/cli/clamp.test.ts
@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { clamp } from '../../src/cli/clamp.ts';
+
+test('clamp returns a value inside the range unchanged', () => {
+  assert.equal(clamp(5, 1, 10), 5);
+});
+
+test('clamp limits values below min and above max', () => {
+  assert.equal(clamp(-3, 1, 10), 1);
+  assert.equal(clamp(30, 1, 10), 10);
+});
+
+test('clamp accepts min equal to max', () => {
+  assert.equal(clamp(7, 4, 4), 4);
+});
+
+test('clamp rejects min greater than max', () => {
+  assert.throws(() => clamp(5, 10, 1), RangeError);
+});
