@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRange } from '../../src/cli/range.ts';
+
+test('expands ranges and single values', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('parses a single number and tolerates spaces', () => {
+  assert.deepEqual(parseRange('7'), [7]);
+  assert.deepEqual(parseRange(' 1 - 2 , 4 '), [1, 2, 4]);
+});
+
+test('rejects malformed input', () => {
+  for (const bad of ['', 'a', '1-', '1,,2', '-3']) {
+    assert.throws(() => parseRange(bad), /Invalid range part/);
+  }
+});
+
+test('rejects descending ranges', () => {
+  assert.throws(() => parseRange('3-1'), /Descending/);
+});
