@@ -0,0 +1,19 @@
+const ELLIPSIS = '…';
+
+/**
+ * Shortens `text` to at most `max` characters (code points) by replacing the
+ * middle with an ellipsis, keeping both ends. The head gets the odd character.
+ */
+export function truncateMiddle(text: string, max: number): string {
+  const chars = Array.from(text);
+  if (chars.length <= max) return text;
+  if (!(max >= 1)) return '';
+  const keep = Math.floor(max) - 1;
+  const head = Math.ceil(keep / 2);
+  const tail = keep - head;
+  return (
+    chars.slice(0, head).join('') +
+    ELLIPSIS +
+    (tail > 0 ? chars.slice(chars.length - tail).join('') : '')
+  );
+}
