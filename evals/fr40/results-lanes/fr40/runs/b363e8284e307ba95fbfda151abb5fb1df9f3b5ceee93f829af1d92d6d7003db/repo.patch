@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRange } from '../../src/cli/range.ts';
+
+test('parse range expands ranges and single numbers', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('parse range accepts a single number and surrounding spaces', () => {
+  assert.deepEqual(parseRange('7'), [7]);
+  assert.deepEqual(parseRange(' 1 - 2 , 4 '), [1, 2, 4]);
+});
+
+test('parse range returns an empty list for empty text', () => {
+  assert.deepEqual(parseRange(''), []);
+});
+
+test('parse range rejects malformed and descending segments', () => {
+  assert.throws(() => parseRange('a'), /invalid range segment/);
+  assert.throws(() => parseRange('1,,2'), /invalid range segment/);
+  assert.throws(() => parseRange('3-1'), /descending range/);
+});
