@@ -0,0 +1,15 @@
+/** Expands a comma-separated list of numbers and inclusive ranges, e.g. `1-3,5` -> `[1, 2, 3, 5]`. */
+export function parseRange(text: string): number[] {
+  const out: number[] = [];
+  if (text.trim() === '') return out;
+  for (const raw of text.split(',')) {
+    const part = raw.trim();
+    const m = /^(\d+)(?:\s*-\s*(\d+))?$/.exec(part);
+    if (!m) throw new Error(`invalid range segment: "${part}"`);
+    const start = Number(m[1]);
+    const end = m[2] === undefined ? start : Number(m[2]);
+    if (end < start) throw new Error(`descending range: "${part}"`);
+    for (let n = start; n <= end; n++) out.push(n);
+  }
+  return out;
+}
