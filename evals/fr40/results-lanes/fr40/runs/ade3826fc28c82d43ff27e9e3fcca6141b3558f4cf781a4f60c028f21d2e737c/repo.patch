+/** Render `part` as a percentage of `total` with one decimal; `0.0%` when total is zero. */
+export function percent(part: number, total: number): string {
+  if (total === 0) return '0.0%';
+  return `${((part / total) * 100).toFixed(1)}%`;
+}
