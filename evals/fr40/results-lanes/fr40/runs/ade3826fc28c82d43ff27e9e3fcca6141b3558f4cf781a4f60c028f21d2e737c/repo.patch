+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { percent } from '../../src/cli/percent.ts';
+
+test('percent renders one decimal', () => {
+  assert.equal(percent(1, 4), '25.0%');
+  assert.equal(percent(1, 3), '33.3%');
+  assert.equal(percent(2, 3), '66.7%');
+});
+
+test('percent renders 0.0% for a zero total', () => {
+  assert.equal(percent(0, 0), '0.0%');
+  assert.equal(percent(5, 0), '0.0%');
+});
+
+test('percent handles zero part and values above 100%', () => {
+  assert.equal(percent(0, 7), '0.0%');
+  assert.equal(percent(3, 2), '150.0%');
+});
