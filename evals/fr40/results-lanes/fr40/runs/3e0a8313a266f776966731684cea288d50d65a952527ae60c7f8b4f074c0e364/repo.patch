+++ b/test/cli/group-by.test.ts
@@ -0,0 +1,16 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { groupBy } from '../../src/cli/group-by.ts';
+
+test('groupBy keeps input order within and across groups', () => {
+  const result = groupBy(['apple', 'bob', 'avocado', 'banana', 'cherry'], (s) =>
+    s.slice(0, 1),
+  );
+  assert.deepEqual([...result.keys()], ['a', 'b', 'c']);
+  assert.deepEqual(result.get('a'), ['apple', 'avocado']);
+  assert.deepEqual(result.get('b'), ['bob', 'banana']);
+});
+
+test('groupBy returns an empty map for no items', () => {
+  assert.equal(groupBy([], String).size, 0);
+});
