@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRange } from '../../src/cli/range.ts';
+
+test('expands ranges and single numbers', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('accepts a single number and tolerates whitespace', () => {
+  assert.deepEqual(parseRange('7'), [7]);
+  assert.deepEqual(parseRange(' 2 - 4 , 9 '), [2, 3, 4, 9]);
+});
+
+test('rejects empty, malformed and descending input', () => {
+  assert.throws(() => parseRange(''), RangeError);
+  assert.throws(() => parseRange('1,,2'), RangeError);
+  assert.throws(() => parseRange('a-b'), RangeError);
+  assert.throws(() => parseRange('5-3'), RangeError);
+});
