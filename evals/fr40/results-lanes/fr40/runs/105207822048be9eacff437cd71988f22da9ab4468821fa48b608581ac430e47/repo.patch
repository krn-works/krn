+++ b/test/cli/semver.test.ts
@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { compareVersions } from '../../src/cli/semver.ts';
+
+test('equal versions compare as 0', () => {
+  assert.equal(compareVersions('1.2.3', '1.2.3'), 0);
+});
+
+test('versions compare numerically, not lexically', () => {
+  assert.equal(compareVersions('1.10.0', '1.9.0'), 1);
+  assert.equal(compareVersions('1.2.0', '1.10.0'), -1);
+});
+
+test('missing trailing parts count as zero', () => {
+  assert.equal(compareVersions('1.2', '1.2.0'), 0);
+  assert.equal(compareVersions('1.2', '1.2.1'), -1);
+});
+
+test('a non-numeric part is rejected', () => {
+  assert.throws(() => compareVersions('1.x', '1.0'), /invalid version/);
+});
