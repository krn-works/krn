+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { maskSecret } from '../../src/cli/mask.ts';
+
+test('maskSecret keeps the last four characters and stars the rest', () => {
+  assert.equal(maskSecret('abcdefgh'), '****efgh');
+  assert.equal(maskSecret('abcde'), '*bcde');
+});
+
+test('maskSecret fully stars values of four or fewer characters', () => {
+  assert.equal(maskSecret('abcd'), '****');
+  assert.equal(maskSecret('ab'), '**');
+  assert.equal(maskSecret(''), '');
+});
+
+test('maskSecret counts code points, not UTF-16 units', () => {
+  assert.equal(maskSecret('😀😀😀😀😀'), '*😀😀😀😀');
+});
