+/**
+ * Masks a secret for display: keeps the last four characters and replaces the
+ * rest with `*`. A value of four or fewer characters is fully starred so a
+ * short secret is never revealed.
+ */
+export function maskSecret(value: string): string {
+  const chars = [...value];
+  const keep = chars.length > 4 ? 4 : 0;
+  return (
+    '*'.repeat(chars.length - keep) + chars.slice(chars.length - keep).join('')
+  );
+}
