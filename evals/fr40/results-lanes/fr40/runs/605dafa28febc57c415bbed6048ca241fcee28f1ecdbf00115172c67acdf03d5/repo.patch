@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { parseRange } from '../../src/cli/range.ts';
+
+test('expands ranges and singles', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('handles a single number, whitespace and empty input', () => {
+  assert.deepEqual(parseRange('7'), [7]);
+  assert.deepEqual(parseRange(' 1-2 , 4 '), [1, 2, 4]);
+  assert.deepEqual(parseRange(''), []);
+});
+
+test('rejects invalid segments', () => {
+  assert.throws(() => parseRange('a'), /Invalid range/);
+  assert.throws(() => parseRange('3-1'), /Descending/);
+});
