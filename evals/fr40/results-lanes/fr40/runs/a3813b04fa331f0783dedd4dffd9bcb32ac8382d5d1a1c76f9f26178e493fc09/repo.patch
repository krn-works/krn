@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { formatDuration } from '../../src/cli/duration.ts';
+
+test('formats hours, minutes and seconds', () => {
+  assert.equal(formatDuration(3_723_000), '1h 2m 3s');
+});
+
+test('drops zero leading units', () => {
+  assert.equal(formatDuration(125_000), '2m 5s');
+  assert.equal(formatDuration(7_000), '7s');
+  assert.equal(formatDuration(0), '0s');
+});
+
+test('keeps inner zero units after a larger unit', () => {
+  assert.equal(formatDuration(3_600_000), '1h 0m 0s');
+});
+
+test('truncates sub-second remainders and clamps negatives', () => {
+  assert.equal(formatDuration(1_999), '1s');
+  assert.equal(formatDuration(-5), '0s');
+});
