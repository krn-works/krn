@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderTable } from '../../src/cli/table.ts';
+
+test('table pads each column to its widest cell', () => {
+  assert.equal(
+    renderTable([
+      ['name', 'status'],
+      ['a', 'ok'],
+      ['longer', 'fail'],
+    ]),
+    ['name    status', 'a       ok', 'longer  fail'].join('\n'),
+  );
+});
+
+test('table of no rows is empty', () => {
+  assert.equal(renderTable([]), '');
+});
+
+test('table tolerates ragged rows', () => {
+  assert.equal(renderTable([['a'], ['bb', 'c']]), 'a\nbb  c');
+});
