+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { slugify } from '../../src/cli/slug.ts';
+
+test('slugify lowercases and joins words with hyphens', () => {
+  assert.equal(slugify('Hello World'), 'hello-world');
+});
+
+test('slugify strips accents', () => {
+  assert.equal(slugify('Crème Brûlée à la Carte'), 'creme-brulee-a-la-carte');
+});
+
+test('slugify collapses separators and trims edges', () => {
+  assert.equal(slugify('  a -- b__c!  '), 'a-b-c');
+  assert.equal(slugify(''), '');
+});
