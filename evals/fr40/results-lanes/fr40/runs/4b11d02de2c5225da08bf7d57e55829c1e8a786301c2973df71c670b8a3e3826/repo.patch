@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderTable } from '../../src/cli/table.ts';
+
+test('renderTable pads columns to equal width', () => {
+  assert.equal(
+    renderTable([
+      ['name', 'status'],
+      ['a', 'ok'],
+      ['longer', 'fail'],
+    ]),
+    ['name    status', 'a       ok', 'longer  fail'].join('\n'),
+  );
+});
+
+test('renderTable handles empty input and ragged rows', () => {
+  assert.equal(renderTable([]), '');
+  assert.equal(renderTable([['a', 'b', 'c'], ['dd']]), 'a   b  c\ndd');
+});
