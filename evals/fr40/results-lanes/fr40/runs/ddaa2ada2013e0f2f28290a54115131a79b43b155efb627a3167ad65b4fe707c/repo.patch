@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { formatDuration } from '../../src/cli/duration.ts';
+
+test('duration renders hours, minutes and seconds', () => {
+  assert.equal(formatDuration(3_723_000), '1h 2m 3s');
+});
+
+test('duration drops zero leading units', () => {
+  assert.equal(formatDuration(125_000), '2m 5s');
+  assert.equal(formatDuration(7_000), '7s');
+});
+
+test('duration keeps inner zero units', () => {
+  assert.equal(formatDuration(3_601_000), '1h 0m 1s');
+});
+
+test('duration renders zero and sub-second values as 0s', () => {
+  assert.equal(formatDuration(0), '0s');
+  assert.equal(formatDuration(999), '0s');
+});
+
+test('duration treats negative and non-finite input as zero', () => {
+  assert.equal(formatDuration(-5), '0s');
+  assert.equal(formatDuration(Number.NaN), '0s');
+});
