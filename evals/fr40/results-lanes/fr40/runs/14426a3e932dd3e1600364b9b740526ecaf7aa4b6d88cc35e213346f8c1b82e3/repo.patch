@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { groupBy } from '../../src/cli/group-by.ts';
+
+test('groups items and keeps input order within and across groups', () => {
+  const result = groupBy(['b1', 'a1', 'b2', 'a2', 'c1'], (s) => s[0] ?? '');
+  assert.deepEqual(
+    [...result],
+    [
+      ['b', ['b1', 'b2']],
+      ['a', ['a1', 'a2']],
+      ['c', ['c1']],
+    ],
+  );
+});
+
+test('returns an empty map for no items', () => {
+  assert.equal(groupBy([], () => 'x').size, 0);
+});
