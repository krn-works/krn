diff --git a/src/cli/semver.ts b/src/cli/semver.ts
new file mode 100644
index 0000000..a8c1b3e
--- /dev/null
+++ b/src/cli/semver.ts
@@ -0,0 +1,21 @@
+function parseParts(version: string): number[] {
+  const parts = version.split('.');
+  return parts.map((part) => {
+    if (!/^\d+$/.test(part)) {
+      throw new Error(`Invalid version: ${JSON.stringify(version)}`);
+    }
+    return Number(part);
+  });
+}
+
+/** Orders dotted numeric versions: -1 if a < b, 0 if equal, 1 if a > b. Missing parts count as 0. */
+export function compareVersions(a: string, b: string): number {
+  const left = parseParts(a);
+  const right = parseParts(b);
+  const length = Math.max(left.length, right.length);
+  for (let i = 0; i < length; i++) {
+    const diff = (left[i] ?? 0) - (right[i] ?? 0);
+    if (diff !== 0) return diff < 0 ? -1 : 1;
+  }
+  return 0;
+}
diff --git a/test/cli/semver.test.ts b/test/cli/semver.test.ts
new file mode 100644
index 0000000..3eee90f
--- /dev/null
+++ b/test/cli/semver.test.ts
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { compareVersions } from '../../src/cli/semver.ts';
+
+test('equal versions compare as 0, ignoring trailing zero parts', () => {
+  assert.equal(compareVersions('1.2.3', '1.2.3'), 0);
+  assert.equal(compareVersions('1.2', '1.2.0'), 0);
+});
+
+test('compares numerically, not lexically', () => {
+  assert.equal(compareVersions('1.10.0', '1.9.0'), 1);
+  assert.equal(compareVersions('1.2.3', '1.2.10'), -1);
+});
+
+test('a longer version with a nonzero tail is greater', () => {
+  assert.equal(compareVersions('1.2', '1.2.1'), -1);
+  assert.equal(compareVersions('2', '1.9.9'), 1);
+});
+
+test('rejects non-numeric versions', () => {
+  assert.throws(() => compareVersions('1.x', '1.0'), /Invalid version/);
+  assert.throws(() => compareVersions('1.0', ''), /Invalid version/);
+});
