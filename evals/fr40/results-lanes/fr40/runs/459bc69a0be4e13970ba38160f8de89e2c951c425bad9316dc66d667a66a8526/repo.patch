+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { wrapText } from '../../src/core/wrap.ts';
+
+test('wraps at word boundaries', () => {
+  assert.deepEqual(wrapText('the quick brown fox', 9), [
+    'the quick',
+    'brown fox',
+  ]);
+});
+
+test('keeps a word equal to the width intact', () => {
+  assert.deepEqual(wrapText('abcde fg', 5), ['abcde', 'fg']);
+});
+
+test('hard-splits only words longer than the width', () => {
+  assert.deepEqual(wrapText('ab abcdefg', 3), ['ab', 'abc', 'def', 'g']);
+});
+
+test('collapses whitespace and handles empty text', () => {
+  assert.deepEqual(wrapText('  a   b ', 10), ['a b']);
+  assert.deepEqual(wrapText('', 10), []);
+});
