new file mode 100644
index 0000000..7df99e9
--- /dev/null
+++ b/src/cli/retry.ts
@@ -0,0 +1,8 @@
+const MAX_DELAY_MS = 30_000;
+
+/** Doubling retry delays starting at `baseMs`, capped at 30 seconds. */
+export function backoffDelays(attempts: number, baseMs: number): number[] {
+  return Array.from({ length: Math.max(0, Math.floor(attempts)) }, (_, i) =>
+    Math.min(baseMs * 2 ** i, MAX_DELAY_MS),
+  );
+}
diff --git a/test/cli/retry.test.ts b/test/cli/retry.test.ts
new file mode 100644
