@@ -0,0 +1,17 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRange } from '../../src/cli/range.ts';
+
+test('parseRange expands ranges and single numbers', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('parseRange accepts a single number and surrounding spaces', () => {
+  assert.deepEqual(parseRange(' 4 , 6-7'), [4, 6, 7]);
+});
+
+test('parseRange rejects malformed and descending segments', () => {
+  assert.throws(() => parseRange('a'), /Invalid range/);
+  assert.throws(() => parseRange('1,,2'), /Invalid range/);
+  assert.throws(() => parseRange('3-1'), /Descending/);
+});
