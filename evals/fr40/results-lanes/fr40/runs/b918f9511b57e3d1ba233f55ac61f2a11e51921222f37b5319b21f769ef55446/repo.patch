+/** Expands a comma-separated list of numbers and inclusive ranges, e.g. `1-3,5` → `[1, 2, 3, 5]`. */
+export function parseRange(text: string): number[] {
+  const result: number[] = [];
+  for (const raw of text.split(',')) {
+    const part = raw.trim();
+    const match = /^(\d+)(?:-(\d+))?$/.exec(part);
+    if (!match) throw new Error(`Invalid range segment: "${part}"`);
+    const start = Number(match[1]);
+    const end = match[2] === undefined ? start : Number(match[2]);
+    if (end < start) throw new Error(`Descending range: "${part}"`);
+    for (let n = start; n <= end; n++) result.push(n);
+  }
+  return result;
+}
