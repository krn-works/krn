@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { wrapText } from '../../src/cli/wrap.ts';
+
+test('wrapText breaks lines at word boundaries within the width', () => {
+  assert.deepEqual(wrapText('the quick brown fox', 9), [
+    'the quick',
+    'brown fox',
+  ]);
+});
+
+test('wrapText keeps a word equal to the width whole', () => {
+  assert.deepEqual(wrapText('abc defgh i', 5), ['abc', 'defgh', 'i']);
+});
+
+test('wrapText splits only words longer than the width', () => {
+  assert.deepEqual(wrapText('ab abcdefg', 3), ['ab', 'abc', 'def', 'g']);
+});
+
+test('wrapText returns no lines for blank text', () => {
+  assert.deepEqual(wrapText('  \n ', 10), []);
+});
