+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRange } from '../../src/cli/range.ts';
+
+test('expands ranges and single numbers', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('handles a single number and whitespace', () => {
+  assert.deepEqual(parseRange('7'), [7]);
+  assert.deepEqual(parseRange(' 1 - 2 , 4 '), [1, 2, 4]);
+});
+
+test('rejects invalid input', () => {
+  for (const bad of ['', '1,,2', 'a', '3-1', '1-', '-2']) {
+    assert.throws(() => parseRange(bad), RangeError, bad);
+  }
+});
