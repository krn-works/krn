index 0000000..870c12c
--- /dev/null
+++ b/src/cli/clamp.ts
@@ -0,0 +1,6 @@
+/** Limits `value` to the inclusive range [min, max]; a reversed range is a caller error. */
+export function clamp(value: number, min: number, max: number): number {
+  if (min > max)
+    throw new RangeError(`clamp: min ${min} is greater than max ${max}`);
+  return Math.min(Math.max(value, min), max);
+}
diff --git a/test/cli/clamp.test.ts b/test/cli/clamp.test.ts
new file mode 100644
index 0000000..66e7414
--- /dev/null
+++ b/test/cli/clamp.test.ts
@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { clamp } from '../../src/cli/clamp.ts';
+
+test('clamp returns a value inside the range unchanged', () => {
+  assert.equal(clamp(5, 0, 10), 5);
+});
+
+test('clamp limits values below min and above max', () => {
+  assert.equal(clamp(-3, 0, 10), 0);
+  assert.equal(clamp(42, 0, 10), 10);
+});
+
+test('clamp accepts min equal to max', () => {
+  assert.equal(clamp(7, 3, 3), 3);
+});
+
+test('clamp rejects min greater than max', () => {
+  assert.throws(() => clamp(5, 10, 0), RangeError);
+});
