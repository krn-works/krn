+/**
+ * Hides a secret for display: keeps the last four characters and replaces the
+ * rest with stars. Values of four characters or fewer are starred entirely so
+ * a short secret is never revealed.
+ */
+export function maskSecret(value: string): string {
+  const chars = Array.from(value);
+  if (chars.length <= 4) return '*'.repeat(chars.length);
+  return '*'.repeat(chars.length - 4) + chars.slice(-4).join('');
+}
