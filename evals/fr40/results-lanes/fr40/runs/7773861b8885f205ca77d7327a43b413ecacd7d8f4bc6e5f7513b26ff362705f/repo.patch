@@ -0,0 +1,16 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { formatDuration } from '../src/core/duration.ts';
+
+test('formatDuration drops zero leading units', () => {
+  assert.equal(formatDuration(0), '0s');
+  assert.equal(formatDuration(3000), '3s');
+  assert.equal(formatDuration(62_000), '1m 2s');
+  assert.equal(formatDuration(3_723_000), '1h 2m 3s');
+});
+
+test('formatDuration keeps interior zeros and floors sub-second', () => {
+  assert.equal(formatDuration(3_600_000), '1h 0m 0s');
+  assert.equal(formatDuration(3_603_999), '1h 0m 3s');
+  assert.equal(formatDuration(-5), '0s');
+});
