@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { formatDuration } from '../../src/cli/duration.ts';
+
+test('formatDuration renders hours, minutes and seconds', () => {
+  assert.equal(formatDuration(3_723_000), '1h 2m 3s');
+});
+
+test('formatDuration drops zero leading units', () => {
+  assert.equal(formatDuration(0), '0s');
+  assert.equal(formatDuration(5_000), '5s');
+  assert.equal(formatDuration(125_000), '2m 5s');
+});
+
+test('formatDuration keeps interior zero units', () => {
+  assert.equal(formatDuration(3_605_000), '1h 0m 5s');
+  assert.equal(formatDuration(60_000), '1m 0s');
+});
+
+test('formatDuration floors sub-second values and clamps invalid input', () => {
+  assert.equal(formatDuration(999), '0s');
+  assert.equal(formatDuration(1_999), '1s');
+  assert.equal(formatDuration(-5), '0s');
+  assert.equal(formatDuration(Number.NaN), '0s');
+});
