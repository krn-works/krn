+++ b/src/cli/table.ts
@@ -0,0 +1,19 @@
+const COLUMN_GAP = '  ';
+
+/** Render rows as plain text with every column padded to its widest cell. */
+export function renderTable(rows: readonly string[][]): string {
+  const widths: number[] = [];
+  for (const row of rows) {
+    row.forEach((cell, i) => {
+      widths[i] = Math.max(widths[i] ?? 0, cell.length);
+    });
+  }
+  return rows
+    .map((row) =>
+      row
+        .map((cell, i) => cell.padEnd(widths[i]))
+        .join(COLUMN_GAP)
+        .trimEnd(),
+    )
+    .join('\n');
+}
