+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderTable } from '../../src/cli/table.ts';
+
+test('render table pads each column to its widest cell', () => {
+  assert.equal(
+    renderTable([
+      ['name', 'status'],
+      ['alpha', 'ok'],
+      ['b', 'failed'],
+    ]),
+    ['name   status', 'alpha  ok', 'b      failed'].join('\n'),
+  );
+});
+
+test('render table handles ragged rows and no rows', () => {
+  assert.equal(renderTable([['a', 'b'], ['ccc']]), 'a    b\nccc');
+  assert.equal(renderTable([]), '');
+});
