+++ b/src/cli/wrap.ts
@@ -0,0 +1,25 @@
+/**
+ * Word-wraps `text` to lines of at most `width` characters. Whitespace runs
+ * collapse to one space. A word that fits within `width` is never split; only
+ * a word longer than `width` is broken into `width`-sized pieces.
+ */
+export function wrapText(text: string, width: number): string[] {
+  const limit = Math.max(1, Math.floor(width));
+  const lines: string[] = [];
+  let line = '';
+  for (const word of text.split(/\s+/).filter(Boolean)) {
+    if (line && line.length + 1 + word.length <= limit) {
+      line += ` ${word}`;
+      continue;
+    }
+    if (line) lines.push(line);
+    let rest = word;
+    while (rest.length > limit) {
+      lines.push(rest.slice(0, limit));
+      rest = rest.slice(limit);
+    }
+    line = rest;
+  }
+  if (line) lines.push(line);
+  return lines;
+}
diff --git a/test/cli/wrap.test.ts b/test/cli/wrap.test.ts
new file mode 100644
index 0000000..fe42c0c
--- /dev/null
+++ b/test/cli/wrap.test.ts
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { wrapText } from '../../src/cli/wrap.ts';
+
+test('wraps at word boundaries within the width', () => {
+  assert.deepEqual(wrapText('the quick brown fox', 9), [
+    'the quick',
+    'brown fox',
+  ]);
+});
+
+test('keeps a word equal to the width whole', () => {
+  assert.deepEqual(wrapText('abc def', 3), ['abc', 'def']);
+});
+
+test('collapses whitespace and returns no lines for empty text', () => {
+  assert.deepEqual(wrapText('  a   b  ', 10), ['a b']);
+  assert.deepEqual(wrapText('', 10), []);
+});
+
+test('breaks only words longer than the width', () => {
+  assert.deepEqual(wrapText('ab abcdefg', 3), ['ab', 'abc', 'def', 'g']);
+});
