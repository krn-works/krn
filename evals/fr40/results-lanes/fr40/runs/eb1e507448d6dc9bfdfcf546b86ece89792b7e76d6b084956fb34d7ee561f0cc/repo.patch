+/** Keeps the last four characters of `value` and replaces the rest with stars. */
+export function maskSecret(value: string): string {
+  const chars = Array.from(value);
+  const keep = Math.min(4, chars.length);
+  return (
+    '*'.repeat(chars.length - keep) + chars.slice(chars.length - keep).join('')
+  );
+}
