@@ -0,0 +1,14 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { groupBy } from '../../src/cli/group-by.ts';
+
+test('groupBy keeps input order within and across groups', () => {
+  const groups = groupBy(['bb', 'a', 'cc', 'd', 'e'], (s) => String(s.length));
+  assert.deepEqual([...groups.keys()], ['2', '1']);
+  assert.deepEqual(groups.get('2'), ['bb', 'cc']);
+  assert.deepEqual(groups.get('1'), ['a', 'd', 'e']);
+});
+
+test('groupBy returns an empty map for no items', () => {
+  assert.equal(groupBy([], String).size, 0);
+});
