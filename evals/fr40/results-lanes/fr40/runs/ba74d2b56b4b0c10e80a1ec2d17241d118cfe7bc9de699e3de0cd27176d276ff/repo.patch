+++ b/test/cli/group-by.test.ts
@@ -0,0 +1,14 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { groupBy } from '../../src/cli/group-by.ts';
+
+test('groupBy keeps input order of groups and items', () => {
+  const result = groupBy(['bb', 'a', 'cc', 'd', 'e'], (s) => String(s.length));
+  assert.deepEqual([...result.keys()], ['2', '1']);
+  assert.deepEqual(result.get('2'), ['bb', 'cc']);
+  assert.deepEqual(result.get('1'), ['a', 'd', 'e']);
+});
+
+test('groupBy returns an empty map for empty input', () => {
+  assert.equal(groupBy([], () => 'x').size, 0);
+});
