@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { formatDuration } from '../../src/cli/duration.ts';
+
+test('formatDuration drops zero leading units', () => {
+  assert.equal(formatDuration(0), '0s');
+  assert.equal(formatDuration(999), '0s');
+  assert.equal(formatDuration(3000), '3s');
+  assert.equal(formatDuration(63_000), '1m 3s');
+  assert.equal(formatDuration(3_723_000), '1h 2m 3s');
+});
+
+test('formatDuration keeps inner zero units', () => {
+  assert.equal(formatDuration(3_600_000), '1h 0m 0s');
+  assert.equal(formatDuration(3_603_000), '1h 0m 3s');
+  assert.equal(formatDuration(60_000), '1m 0s');
+});
+
+test('formatDuration clamps negative and non-finite input', () => {
+  assert.equal(formatDuration(-5), '0s');
+  assert.equal(formatDuration(Number.NaN), '0s');
+});
