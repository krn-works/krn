diff --git a/src/cli/env-flag.ts b/src/cli/env-flag.ts
new file mode 100644
index 0000000..e3333ee
--- /dev/null
+++ b/src/cli/env-flag.ts
@@ -0,0 +1,7 @@
+const TRUTHY = new Set(['1', 'true', 'yes', 'on']);
+
+/** Parses an environment-style flag: 1/true/yes/on (any case) are true. */
+export function parseFlag(value: string | undefined): boolean {
+  if (value === undefined) return false;
+  return TRUTHY.has(value.trim().toLowerCase());
+}
diff --git a/test/cli/env-flag.test.ts b/test/cli/env-flag.test.ts
new file mode 100644
index 0000000..33be949
--- /dev/null
+++ b/test/cli/env-flag.test.ts
@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseFlag } from '../../src/cli/env-flag.ts';
+
+test('parseFlag accepts 1/true/yes/on case-insensitively', () => {
+  for (const v of ['1', 'true', 'TRUE', 'Yes', 'yEs', 'on', 'ON']) {
+    assert.equal(parseFlag(v), true, v);
+  }
+});
+
+test('parseFlag rejects everything else', () => {
+  for (const v of [undefined, '', '0', 'false', 'no', 'off', '2', 'y']) {
+    assert.equal(parseFlag(v), false, String(v));
+  }
+});
