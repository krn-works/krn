diff --git a/src/core/slug.ts b/src/core/slug.ts
new file mode 100644
index 0000000..916a498
--- /dev/null
+++ b/src/core/slug.ts
@@ -0,0 +1,9 @@
+export function slugify(text: string): string {
+  return text
+    .normalize('NFD')
+    .replace(/\p{M}/gu, '')
+    .toLowerCase()
+    .split(/[^a-z0-9]+/)
+    .filter(Boolean)
+    .join('-');
+}
