--- /dev/null
+++ b/src/cli/retry.ts
@@ -0,0 +1,9 @@
+const MAX_DELAY_MS = 30_000;
+
+/** Doubling retry delays starting at baseMs, each capped at 30 seconds. */
+export function backoffDelays(attempts: number, baseMs: number): number[] {
+  const count = Math.max(0, Math.floor(attempts));
+  return Array.from({ length: count }, (_, i) =>
+    Math.min(baseMs * 2 ** i, MAX_DELAY_MS),
+  );
+}
