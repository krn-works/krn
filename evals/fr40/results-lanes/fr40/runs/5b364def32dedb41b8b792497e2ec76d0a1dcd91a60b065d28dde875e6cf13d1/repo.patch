@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { backoffDelays } from '../../src/cli/retry.ts';
+
+test('backoffDelays doubles from the base delay', () => {
+  assert.deepEqual(backoffDelays(4, 100), [100, 200, 400, 800]);
+});
+
+test('backoffDelays caps each delay at 30 seconds', () => {
+  assert.deepEqual(
+    backoffDelays(5, 10_000),
+    [10_000, 20_000, 30_000, 30_000, 30_000],
+  );
+});
+
+test('backoffDelays returns nothing for zero attempts', () => {
+  assert.deepEqual(backoffDelays(0, 100), []);
+});
