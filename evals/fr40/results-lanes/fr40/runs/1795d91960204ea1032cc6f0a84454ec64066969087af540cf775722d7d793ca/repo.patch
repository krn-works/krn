@@ -0,0 +1,22 @@
+/**
+ * Compare dotted numeric versions ("1.2.10" vs "1.3").
+ * Returns -1, 0, or 1. Missing segments count as 0.
+ */
+export function compareVersions(a: string, b: string): number {
+  const pa = parseVersion(a);
+  const pb = parseVersion(b);
+  const len = Math.max(pa.length, pb.length);
+  for (let i = 0; i < len; i++) {
+    const x = pa[i] ?? 0;
+    const y = pb[i] ?? 0;
+    if (x !== y) return x < y ? -1 : 1;
+  }
+  return 0;
+}
+
+function parseVersion(v: string): number[] {
+  if (!/^\d+(\.\d+)*$/.test(v)) {
+    throw new TypeError(`Invalid dotted numeric version: ${JSON.stringify(v)}`);
+  }
+  return v.split('.').map(Number);
+}
diff --git a/test/cli/semver.test.ts b/test/cli/semver.test.ts
new file mode 100644
