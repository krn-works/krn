@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { renderTable } from '../../src/core/table.ts';
+
+test('renderTable pads columns to equal width', () => {
+  assert.equal(
+    renderTable([
+      ['name', 'id'],
+      ['alpha', '1'],
+      ['b', '22'],
+    ]),
+    ['name   id', 'alpha  1', 'b      22'].join('\n'),
+  );
+});
+
+test('renderTable handles ragged and empty input', () => {
+  assert.equal(renderTable([]), '');
+  assert.equal(renderTable([['a', 'b', 'c'], ['dd']]), 'a   b  c\ndd');
+});
