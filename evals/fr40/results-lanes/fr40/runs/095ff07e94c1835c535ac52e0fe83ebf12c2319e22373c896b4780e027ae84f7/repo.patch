+++ b/src/cli/env-flag.ts
@@ -0,0 +1,6 @@
+const TRUTHY = new Set(['1', 'true', 'yes', 'on']);
+
+/** True when an environment value spells an enabled flag: 1, true, yes or on, in any case. */
+export function parseFlag(value: string | undefined): boolean {
+  return value !== undefined && TRUTHY.has(value.trim().toLowerCase());
+}
diff --git a/test/cli/env-flag.test.ts b/test/cli/env-flag.test.ts
new file mode 100644
index 0000000..c4e046a
--- /dev/null
+++ b/test/cli/env-flag.test.ts
@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseFlag } from '../../src/cli/env-flag.ts';
+
+test('parse flag accepts 1, true, yes and on in any case', () => {
+  for (const value of ['1', 'true', 'TRUE', 'Yes', 'yes', 'ON', 'on']) {
+    assert.equal(parseFlag(value), true, value);
+  }
+});
+
+test('parse flag rejects absent, empty and other values', () => {
+  for (const value of [undefined, '', '0', 'false', 'no', 'off', 'maybe']) {
+    assert.equal(parseFlag(value), false, String(value));
+  }
+});
