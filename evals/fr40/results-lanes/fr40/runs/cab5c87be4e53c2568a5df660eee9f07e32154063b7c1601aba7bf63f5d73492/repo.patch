+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { maskSecret } from '../../src/cli/mask.ts';
+
+test('maskSecret keeps the last four characters', () => {
+  assert.equal(maskSecret('abcdefgh'), '****efgh');
+});
+
+test('maskSecret leaves short values unstarred', () => {
+  assert.equal(maskSecret('abcd'), 'abcd');
+  assert.equal(maskSecret('ab'), 'ab');
+  assert.equal(maskSecret(''), '');
+});
