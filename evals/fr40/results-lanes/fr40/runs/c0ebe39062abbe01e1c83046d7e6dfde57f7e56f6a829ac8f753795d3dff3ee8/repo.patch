@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderTable } from '../../src/cli/table.ts';
+
+test('render table pads each column to its widest cell', () => {
+  assert.equal(
+    renderTable([
+      ['name', 'id'],
+      ['alpha', '1'],
+    ]),
+    'name   id\nalpha  1',
+  );
+});
+
+test('render table of no rows is empty', () => {
+  assert.equal(renderTable([]), '');
+});
+
+test('render table tolerates ragged rows', () => {
+  assert.equal(renderTable([['a', 'b', 'c'], ['dd']]), 'a   b  c\ndd');
+});
