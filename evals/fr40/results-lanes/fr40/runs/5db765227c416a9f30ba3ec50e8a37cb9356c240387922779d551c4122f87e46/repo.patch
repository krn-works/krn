Add chunk helper that splits lists into fixed-size groups

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>


diff --git a/src/core/chunk.ts b/src/core/chunk.ts
new file mode 100644
index 0000000..f1218eb
--- /dev/null
+++ b/src/core/chunk.ts
@@ -0,0 +1,8 @@
+export function chunk<T>(items: readonly T[], size: number): T[][] {
+  if (!Number.isInteger(size) || size < 1) {
+    throw new RangeError(`chunk size must be an integer >= 1, got ${size}`);
+  }
+  return Array.from({ length: Math.ceil(items.length / size) }, (_, i) =>
+    items.slice(i * size, (i + 1) * size),
+  );
+}
diff --git a/test/core/chunk.test.ts b/test/core/chunk.test.ts
new file mode 100644
