+const VISIBLE = 4;
+
+/** Keep the last four characters and star the rest; short values are fully starred. */
+export function maskSecret(value: string): string {
+  const chars = Array.from(value);
+  if (chars.length <= VISIBLE) return '*'.repeat(chars.length);
+  return '*'.repeat(chars.length - VISIBLE) + chars.slice(-VISIBLE).join('');
+}
