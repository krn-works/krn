index 0000000..432a4d6
--- /dev/null
+++ b/src/core/duration.ts
@@ -0,0 +1,18 @@
+/** Renders milliseconds as `1h 2m 3s`, dropping zero leading units. */
+export function formatDuration(ms: number): string {
+  const total = Math.max(0, Math.floor(ms / 1000));
+  const parts = [
+    Math.floor(total / 3600),
+    Math.floor(total / 60) % 60,
+    total % 60,
+  ];
+  const units = ['h', 'm', 's'];
+  const first = Math.min(
+    parts.findIndex((n) => n > 0) === -1 ? 2 : parts.findIndex((n) => n > 0),
+    2,
+  );
+  return parts
+    .slice(first)
+    .map((n, i) => `${n}${units[first + i]}`)
+    .join(' ');
+}
