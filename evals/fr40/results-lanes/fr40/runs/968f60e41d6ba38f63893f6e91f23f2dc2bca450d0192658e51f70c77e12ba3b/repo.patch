@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { formatDuration } from '../../src/core/duration.ts';
+
+test('formatDuration renders hours, minutes and seconds', () => {
+  assert.equal(formatDuration(3_723_000), '1h 2m 3s');
+});
+
+test('formatDuration drops zero leading units', () => {
+  assert.equal(formatDuration(123_000), '2m 3s');
+  assert.equal(formatDuration(3_000), '3s');
+});
+
+test('formatDuration keeps zero inner units', () => {
+  assert.equal(formatDuration(3_603_000), '1h 0m 3s');
+});
+
+test('formatDuration renders zero and negative as 0s and floors sub-second', () => {
+  assert.equal(formatDuration(0), '0s');
+  assert.equal(formatDuration(-5), '0s');
+  assert.equal(formatDuration(999), '0s');
+});
