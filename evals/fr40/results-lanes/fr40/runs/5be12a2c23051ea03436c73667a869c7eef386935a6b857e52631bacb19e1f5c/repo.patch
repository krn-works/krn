index 0000000..df00b91
--- /dev/null
+++ b/src/cli/retry.ts
@@ -0,0 +1,11 @@
+const MAX_DELAY_MS = 30_000;
+
+/** Doubling retry delays starting at baseMs, capped at 30 seconds. */
+export function backoffDelays(attempts: number, baseMs: number): number[] {
+  const count = Math.max(0, Math.floor(attempts));
+  const delays: number[] = [];
+  for (let i = 0; i < count; i++) {
+    delays.push(Math.min(baseMs * 2 ** i, MAX_DELAY_MS));
+  }
+  return delays;
+}
