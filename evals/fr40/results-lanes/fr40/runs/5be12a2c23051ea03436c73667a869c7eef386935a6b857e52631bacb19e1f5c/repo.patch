@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { backoffDelays } from '../../src/cli/retry.ts';
+
+test('backoff delays double from the base', () => {
+  assert.deepEqual(backoffDelays(4, 100), [100, 200, 400, 800]);
+});
+
+test('backoff delays are capped at 30 seconds', () => {
+  assert.deepEqual(backoffDelays(4, 10_000), [10_000, 20_000, 30_000, 30_000]);
+});
+
+test('backoff delays are empty for zero attempts', () => {
+  assert.deepEqual(backoffDelays(0, 100), []);
+});
