@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { wrapText } from '../../src/core/wrap.ts';
+
+test('wraps on word boundaries without splitting short words', () => {
+  assert.deepEqual(wrapText('the quick brown fox jumps', 10), [
+    'the quick',
+    'brown fox',
+    'jumps',
+  ]);
+});
+
+test('keeps words that exactly fill the width', () => {
+  assert.deepEqual(wrapText('abcde fghij', 5), ['abcde', 'fghij']);
+  assert.deepEqual(wrapText('ab cd', 5), ['ab cd']);
+});
+
+test('collapses extra whitespace and returns no lines for empty text', () => {
+  assert.deepEqual(wrapText('  a \n\n b  ', 10), ['a b']);
+  assert.deepEqual(wrapText('   ', 10), []);
+});
+
+test('breaks only words longer than the width', () => {
+  assert.deepEqual(wrapText('ab abcdefg', 3), ['ab', 'abc', 'def', 'g']);
+});
