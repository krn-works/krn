new file mode 100644
index 0000000..e00ac37
--- /dev/null
+++ b/src/core/median.ts
@@ -0,0 +1,8 @@
+export function median(values: readonly number[]): number {
+  if (!values.length) throw new RangeError('median of an empty list');
+  const sorted = [...values].sort((a, b) => a - b);
+  const mid = sorted.length >> 1;
+  return sorted.length % 2
+    ? (sorted[mid] as number)
+    : ((sorted[mid - 1] as number) + (sorted[mid] as number)) / 2;
+}
diff --git a/test/core/median.test.ts b/test/core/median.test.ts
new file mode 100644
index 0000000..a6e5b69
--- /dev/null
+++ b/test/core/median.test.ts
@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { median } from '../../src/core/median.ts';
+
+test('median picks the middle of an odd-length list', () => {
+  assert.equal(median([3, 1, 2]), 2);
+});
+
+test('median averages the middle pair of an even-length list', () => {
+  assert.equal(median([4, 1, 3, 2]), 2.5);
+});
+
+test('median does not mutate its input', () => {
+  const input = [3, 1, 2];
+  median(input);
+  assert.deepEqual(input, [3, 1, 2]);
+});
+
+test('median rejects an empty list', () => {
+  assert.throws(() => median([]), RangeError);
+});
