@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { formatDuration } from '../../src/cli/duration.ts';
+
+test('formatDuration renders hours, minutes and seconds', () => {
+  assert.equal(formatDuration(3_723_000), '1h 2m 3s');
+});
+
+test('formatDuration drops zero leading units', () => {
+  assert.equal(formatDuration(123_000), '2m 3s');
+  assert.equal(formatDuration(3_000), '3s');
+  assert.equal(formatDuration(0), '0s');
+});
+
+test('formatDuration keeps inner zero units', () => {
+  assert.equal(formatDuration(3_600_000), '1h 0m 0s');
+});
+
+test('formatDuration truncates sub-second and clamps negatives', () => {
+  assert.equal(formatDuration(1_999), '1s');
+  assert.equal(formatDuration(-5), '0s');
+});
