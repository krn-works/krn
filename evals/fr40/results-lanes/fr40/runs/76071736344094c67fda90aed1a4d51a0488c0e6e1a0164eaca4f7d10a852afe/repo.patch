+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { plural } from '../../src/cli/plural.ts';
+
+test('plural renders a singular noun for a count of one', () => {
+  assert.equal(plural(1, 'file'), '1 file');
+});
+
+test('plural renders a plural noun for other counts', () => {
+  assert.equal(plural(2, 'file'), '2 files');
+  assert.equal(plural(0, 'file'), '0 files');
+});
