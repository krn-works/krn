@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRange } from '../../src/cli/range.ts';
+
+test('expands ranges and single values', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('accepts a single number and whitespace', () => {
+  assert.deepEqual(parseRange('7'), [7]);
+  assert.deepEqual(parseRange(' 1-2 '), [1, 2]);
+  assert.deepEqual(parseRange('1, 4'), [1, 4]);
+});
+
+test('rejects malformed or descending input', () => {
+  assert.throws(() => parseRange(''));
+  assert.throws(() => parseRange('a'));
+  assert.throws(() => parseRange('3-1'));
+  assert.throws(() => parseRange('1,,2'));
+});
