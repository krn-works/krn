new file mode 100644
index 0000000..4352e42
--- /dev/null
+++ b/src/cli/truncate.ts
@@ -0,0 +1,16 @@
+const ELLIPSIS = '…';
+
+/**
+ * Shortens `text` to at most `max` characters, keeping both ends around an
+ * ellipsis. Text that already fits is returned unchanged. When the head and
+ * tail cannot both fit, the head gets the extra character.
+ */
+export function truncateMiddle(text: string, max: number): string {
+  if (text.length <= max) return text;
+  if (max <= 0) return '';
+  const keep = max - ELLIPSIS.length;
+  if (keep <= 0) return ELLIPSIS.slice(0, max);
+  const tail = Math.floor(keep / 2);
+  const head = keep - tail;
+  return text.slice(0, head) + ELLIPSIS + (tail > 0 ? text.slice(-tail) : '');
+}
diff --git a/test/cli/truncate.test.ts b/test/cli/truncate.test.ts
new file mode 100644
index 0000000..4675d1f
--- /dev/null
+++ b/test/cli/truncate.test.ts
@@ -0,0 +1,28 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { truncateMiddle } from '../../src/cli/truncate.ts';
+
+test('text that fits is returned unchanged', () => {
+  assert.equal(truncateMiddle('abcdef', 6), 'abcdef');
+  assert.equal(truncateMiddle('abc', 10), 'abc');
+});
+
+test('long text keeps both ends around an ellipsis', () => {
+  assert.equal(truncateMiddle('abcdefghij', 5), 'ab…ij');
+});
+
+test('an odd budget gives the extra character to the head', () => {
+  assert.equal(truncateMiddle('abcdefghij', 6), 'abc…ij');
+});
+
+test('the result never exceeds max', () => {
+  for (let max = 0; max < 12; max++) {
+    assert.ok(truncateMiddle('abcdefghijklmnop', max).length <= max);
+  }
+});
+
+test('tiny budgets degrade to the ellipsis or nothing', () => {
+  assert.equal(truncateMiddle('abcdef', 1), '…');
+  assert.equal(truncateMiddle('abcdef', 0), '');
+  assert.equal(truncateMiddle('abcdef', 2), 'a…');
+});
