+++ b/test/cli/wrap.test.ts
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { wrapText } from '../../src/cli/wrap.ts';
+
+test('wraps at word boundaries', () => {
+  assert.deepEqual(wrapText('the quick brown fox', 9), [
+    'the quick',
+    'brown fox',
+  ]);
+});
+
+test('does not split words that fit the width', () => {
+  assert.deepEqual(wrapText('aaaa bbbb', 4), ['aaaa', 'bbbb']);
+});
+
+test('collapses whitespace and handles empty input', () => {
+  assert.deepEqual(wrapText('  a   b ', 10), ['a b']);
+  assert.deepEqual(wrapText('', 10), []);
+});
+
+test('breaks words longer than the width', () => {
+  assert.deepEqual(wrapText('abcdefg hi', 3), ['abc', 'def', 'g', 'hi']);
+});
