+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { groupBy } from '../../src/cli/group-by.ts';
+
+test('groupBy keeps input order of groups and items', () => {
+  const result = groupBy(['bob', 'amy', 'bill', 'al'], (s) => s.slice(0, 1));
+  assert.deepEqual([...result], [
+    ['b', ['bob', 'bill']],
+    ['a', ['amy', 'al']],
+  ]);
+});
+
+test('groupBy returns an empty map for no items', () => {
+  assert.equal(groupBy([], String).size, 0);
+});
