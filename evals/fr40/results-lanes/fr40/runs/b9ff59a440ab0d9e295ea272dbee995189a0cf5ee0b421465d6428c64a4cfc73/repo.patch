Add countLines helper that ignores a trailing newline (t-6fqavp6)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>


diff --git a/src/cli/count-lines.ts b/src/cli/count-lines.ts
new file mode 100644
index 0000000..6db9d09
--- /dev/null
+++ b/src/cli/count-lines.ts
@@ -0,0 +1,5 @@
+export function countLines(text: string): number {
+  if (text === '') return 0;
+  const parts = text.split('\n');
+  return text.endsWith('\n') ? parts.length - 1 : parts.length;
+}
diff --git a/test/cli/count-lines.test.ts b/test/cli/count-lines.test.ts
new file mode 100644
index 0000000..263bb85
--- /dev/null
+++ b/test/cli/count-lines.test.ts
@@ -0,0 +1,13 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { countLines } from '../../src/cli/count-lines.ts';
+
+test('countLines treats a trailing newline as no extra line', () => {
+  assert.equal(countLines(''), 0);
+  assert.equal(countLines('a'), 1);
+  assert.equal(countLines('a\n'), 1);
+  assert.equal(countLines('a\nb'), 2);
+  assert.equal(countLines('a\nb\n'), 2);
+  assert.equal(countLines('\n'), 1);
+  assert.equal(countLines('\n\n'), 2);
+});
