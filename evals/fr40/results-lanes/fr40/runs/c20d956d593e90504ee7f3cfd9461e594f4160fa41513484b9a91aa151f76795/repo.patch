@@ -0,0 +1,6 @@
+const TRUTHY = new Set(['1', 'true', 'yes', 'on']);
+
+/** True when an environment value is 1/true/yes/on, case-insensitively. */
+export function parseFlag(value: string | undefined): boolean {
+  return value !== undefined && TRUTHY.has(value.trim().toLowerCase());
+}
diff --git a/test/cli/env-flag.test.ts b/test/cli/env-flag.test.ts
new file mode 100644
index 0000000..e4c52e0
--- /dev/null
+++ b/test/cli/env-flag.test.ts
@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { parseFlag } from '../../src/cli/env-flag.ts';
+
+test('parseFlag accepts 1/true/yes/on in any case', () => {
+  for (const v of ['1', 'true', 'TRUE', 'Yes', 'on', 'ON', ' on ']) {
+    assert.equal(parseFlag(v), true, v);
+  }
+});
+
+test('parseFlag rejects everything else', () => {
+  for (const v of [undefined, '', '0', 'false', 'no', 'off', 'maybe']) {
+    assert.equal(parseFlag(v), false, String(v));
+  }
+});
