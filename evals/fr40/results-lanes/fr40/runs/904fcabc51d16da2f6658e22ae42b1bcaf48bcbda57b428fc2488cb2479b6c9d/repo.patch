--- /dev/null
+++ b/test/core/group-by.test.ts
@@ -0,0 +1,18 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { groupBy } from '../../src/core/group-by.ts';
+
+test('groupBy keeps input order within and across groups', () => {
+  const groups = groupBy(['bb', 'a', 'cc', 'd', 'ee'], (s) => String(s.length));
+  assert.deepEqual(
+    [...groups],
+    [
+      ['2', ['bb', 'cc', 'ee']],
+      ['1', ['a', 'd']],
+    ],
+  );
+});
+
+test('groupBy returns an empty map for no items', () => {
+  assert.equal(groupBy([], (s: string) => s).size, 0);
+});
