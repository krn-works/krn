diff --git a/src/cli/mask.ts b/src/cli/mask.ts
new file mode 100644
index 0000000..aba033b
--- /dev/null
+++ b/src/cli/mask.ts
@@ -0,0 +1,12 @@
+const VISIBLE_TAIL = 4;
+
+/** Stars every character except the last four; values of four or fewer are fully starred. */
+export function maskSecret(value: string): string {
+  const chars = Array.from(value);
+  const hidden = Math.max(chars.length - VISIBLE_TAIL, 0);
+  const tail = chars.slice(hidden);
+  return (
+    '*'.repeat(hidden) +
+    (hidden === 0 ? '*'.repeat(tail.length) : tail.join(''))
+  );
+}
