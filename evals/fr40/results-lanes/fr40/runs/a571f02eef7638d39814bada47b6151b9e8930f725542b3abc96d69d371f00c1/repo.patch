@@ -0,0 +1,17 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { maskSecret } from '../../src/cli/mask.ts';
+
+test('mask secret keeps the last four characters', () => {
+  assert.equal(maskSecret('abcdef123456'), '********3456');
+});
+
+test('mask secret stars values of four characters or fewer entirely', () => {
+  assert.equal(maskSecret('abcd'), '****');
+  assert.equal(maskSecret('ab'), '**');
+  assert.equal(maskSecret(''), '');
+});
+
+test('mask secret keeps one star per hidden character of a five-character value', () => {
+  assert.equal(maskSecret('12345'), '*2345');
+});
