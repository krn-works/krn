+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { dedupeBy } from '../src/core/dedupe.ts';
+
+test('dedupeBy keeps the first item per key in order', () => {
+  const items = [
+    { id: 'a', n: 1 },
+    { id: 'b', n: 2 },
+    { id: 'a', n: 3 },
+  ];
+  assert.deepEqual(
+    dedupeBy(items, (i) => i.id),
+    [items[0], items[1]],
+  );
+});
+
+test('dedupeBy handles empty input', () => {
+  assert.deepEqual(dedupeBy([], String), []);
+});
