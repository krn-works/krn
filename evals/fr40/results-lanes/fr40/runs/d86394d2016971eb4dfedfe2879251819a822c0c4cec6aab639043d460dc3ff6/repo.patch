@@ -0,0 +1,9 @@
+const VISIBLE = 4;
+
+// Values no longer than the visible tail are fully starred so short secrets never leak whole.
+export function maskSecret(value: string): string {
+  const chars = [...value];
+  const hidden = Math.max(chars.length - VISIBLE, 0);
+  const tail = chars.length > VISIBLE ? chars.slice(hidden).join('') : '';
+  return '*'.repeat(chars.length > VISIBLE ? hidden : chars.length) + tail;
+}
