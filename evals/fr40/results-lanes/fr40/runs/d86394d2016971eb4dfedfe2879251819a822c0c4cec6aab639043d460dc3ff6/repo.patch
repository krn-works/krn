+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { maskSecret } from '../../src/core/mask.ts';
+
+test('maskSecret keeps the last four characters and stars the rest', () => {
+  assert.equal(maskSecret('abcdefgh1234'), '********1234');
+  assert.equal(maskSecret('12345'), '*2345');
+});
+
+test('maskSecret fully stars values no longer than four characters', () => {
+  assert.equal(maskSecret('abcd'), '****');
+  assert.equal(maskSecret('ab'), '**');
+  assert.equal(maskSecret(''), '');
+});
