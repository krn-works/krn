Add percent helper rendering one decimal

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>


diff --git a/src/core/percent.ts b/src/core/percent.ts
new file mode 100644
index 0000000..9d44c7c
--- /dev/null
+++ b/src/core/percent.ts
@@ -0,0 +1,3 @@
+export function percent(part: number, total: number): string {
+  return `${total === 0 ? '0.0' : ((part / total) * 100).toFixed(1)}%`;
+}
diff --git a/test/core/percent.test.ts b/test/core/percent.test.ts
new file mode 100644
index 0000000..e00fd30
--- /dev/null
+++ b/test/core/percent.test.ts
@@ -0,0 +1,14 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { percent } from '../../src/core/percent.ts';
+
+test('percent renders one decimal', () => {
+  assert.equal(percent(1, 3), '33.3%');
+  assert.equal(percent(1, 1), '100.0%');
+  assert.equal(percent(0, 5), '0.0%');
+});
+
+test('percent renders 0.0% for a zero total', () => {
+  assert.equal(percent(0, 0), '0.0%');
+  assert.equal(percent(5, 0), '0.0%');
+});
