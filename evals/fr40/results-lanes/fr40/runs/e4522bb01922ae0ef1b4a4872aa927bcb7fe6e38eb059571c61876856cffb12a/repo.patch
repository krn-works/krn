+++ b/test/cli/semver.test.ts
@@ -0,0 +1,34 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { compareVersions } from '../../src/cli/semver.ts';
+
+test('orders by numeric part, not lexically', () => {
+  assert.equal(compareVersions('1.2.10', '1.2.9'), 1);
+  assert.equal(compareVersions('1.2.9', '1.2.10'), -1);
+  assert.equal(compareVersions('2', '10'), -1);
+});
+
+test('equal versions, including missing trailing zeros', () => {
+  assert.equal(compareVersions('1.2.3', '1.2.3'), 0);
+  assert.equal(compareVersions('1.2', '1.2.0.0'), 0);
+  assert.equal(compareVersions('01.2', '1.2'), 0);
+});
+
+test('shorter version with a nonzero tail is lower', () => {
+  assert.equal(compareVersions('1.2', '1.2.1'), -1);
+  assert.equal(compareVersions('1.2.1', '1.2'), 1);
+});
+
+test('handles parts beyond safe integer range', () => {
+  assert.equal(
+    compareVersions('1.99999999999999999999', '1.99999999999999999998'),
+    1,
+  );
+});
+
+test('rejects non-numeric input', () => {
+  for (const bad of ['', '1.', '.1', '1..2', '1.a', 'v1.2', '1.2-beta', ' 1']) {
+    assert.throws(() => compareVersions(bad, '1.0'), TypeError, bad);
+    assert.throws(() => compareVersions('1.0', bad), TypeError, bad);
+  }
+});
