diff --git a/src/cli/semver.ts b/src/cli/semver.ts
new file mode 100644
index 0000000..25da7bf
--- /dev/null
+++ b/src/cli/semver.ts
@@ -0,0 +1,25 @@
+function parse(version: string): bigint[] {
+  const parts = version.split('.');
+  for (const part of parts) {
+    if (!/^\d+$/.test(part)) {
+      throw new TypeError(`Invalid dotted numeric version: "${version}"`);
+    }
+  }
+  return parts.map(BigInt);
+}
+
+/**
+ * Orders dotted numeric versions. Returns -1, 0 or 1. Missing trailing parts
+ * count as zero, so `1.2` equals `1.2.0`. Throws TypeError on non-numeric input.
+ */
+export function compareVersions(a: string, b: string): number {
+  const left = parse(a);
+  const right = parse(b);
+  const length = Math.max(left.length, right.length);
+  for (let i = 0; i < length; i++) {
+    const x = left[i] ?? 0n;
+    const y = right[i] ?? 0n;
+    if (x !== y) return x < y ? -1 : 1;
+  }
+  return 0;
+}
