new file mode 100644
index 0000000..61e87ff
--- /dev/null
+++ b/src/core/clamp.ts
@@ -0,0 +1,5 @@
+export function clamp(value: number, min: number, max: number): number {
+  if (min > max)
+    throw new RangeError(`clamp: min ${min} is greater than max ${max}`);
+  return Math.min(Math.max(value, min), max);
+}
diff --git a/test/core/clamp.test.ts b/test/core/clamp.test.ts
new file mode 100644
index 0000000..b015da0
--- /dev/null
+++ b/test/core/clamp.test.ts
@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { clamp } from '../../src/core/clamp.ts';
+
+test('clamp returns values inside the range unchanged', () => {
+  assert.equal(clamp(5, 0, 10), 5);
+});
+
+test('clamp limits values below min and above max', () => {
+  assert.equal(clamp(-1, 0, 10), 0);
+  assert.equal(clamp(11, 0, 10), 10);
+});
+
+test('clamp accepts min equal to max', () => {
+  assert.equal(clamp(3, 4, 4), 4);
+});
+
+test('clamp rejects min greater than max', () => {
+  assert.throws(() => clamp(1, 10, 0), RangeError);
+});
