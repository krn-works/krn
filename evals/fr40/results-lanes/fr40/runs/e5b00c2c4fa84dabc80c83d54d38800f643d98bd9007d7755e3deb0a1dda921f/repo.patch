@@ -0,0 +1,14 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { groupBy } from '../../src/cli/group-by.ts';
+
+test('groupBy keeps input order within and across groups', () => {
+  const result = groupBy(['b1', 'a1', 'b2', 'a2', 'c1'], (s) => s[0] ?? '');
+  assert.deepEqual([...result.keys()], ['b', 'a', 'c']);
+  assert.deepEqual(result.get('b'), ['b1', 'b2']);
+  assert.deepEqual(result.get('a'), ['a1', 'a2']);
+});
+
+test('groupBy returns an empty map for no items', () => {
+  assert.equal(groupBy([], String).size, 0);
+});
