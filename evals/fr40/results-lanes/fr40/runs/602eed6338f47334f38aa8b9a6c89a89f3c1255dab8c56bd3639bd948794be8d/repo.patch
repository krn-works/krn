+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { maskSecret } from '../../src/cli/mask.ts';
+
+test('mask keeps the last four characters and stars the rest', () => {
+  assert.equal(maskSecret('abcdef123456'), '********3456');
+});
+
+test('mask leaves a value of four or fewer characters unchanged', () => {
+  assert.equal(maskSecret('abcd'), 'abcd');
+  assert.equal(maskSecret('ab'), 'ab');
+  assert.equal(maskSecret(''), '');
+});
