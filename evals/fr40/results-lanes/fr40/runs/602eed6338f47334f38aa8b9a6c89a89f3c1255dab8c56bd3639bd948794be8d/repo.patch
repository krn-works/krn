@@ -0,0 +1,8 @@
+const VISIBLE_TAIL = 4;
+
+/** Keeps the last four characters of a secret and replaces the rest with stars. */
+export function maskSecret(value: string): string {
+  const chars = Array.from(value);
+  const hidden = Math.max(0, chars.length - VISIBLE_TAIL);
+  return '*'.repeat(hidden) + chars.slice(hidden).join('');
+}
