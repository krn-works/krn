@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { dedupeBy } from '../../src/cli/dedupe.ts';
+
+test('dedupeBy keeps the first item per key in input order', () => {
+  const items = [
+    { id: 'a', n: 1 },
+    { id: 'b', n: 2 },
+    { id: 'a', n: 3 },
+  ];
+  assert.deepEqual(dedupeBy(items, (i) => i.id), [
+    { id: 'a', n: 1 },
+    { id: 'b', n: 2 },
+  ]);
+});
+
+test('dedupeBy returns an empty array for no items and does not mutate input', () => {
+  assert.deepEqual(dedupeBy([], (s: string) => s), []);
+  const input = ['x', 'x'];
+  dedupeBy(input, (s) => s);
+  assert.deepEqual(input, ['x', 'x']);
+});
