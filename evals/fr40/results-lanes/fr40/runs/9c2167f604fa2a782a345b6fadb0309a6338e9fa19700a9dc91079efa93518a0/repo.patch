Add backoffDelays retry helper with a 30s cap

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>


diff --git a/src/cli/retry.ts b/src/cli/retry.ts
new file mode 100644
index 0000000..d97b4ff
--- /dev/null
+++ b/src/cli/retry.ts
@@ -0,0 +1,10 @@
+const MAX_DELAY_MS = 30_000;
+
+/** Doubling retry delays starting at `baseMs`, each capped at 30 seconds. */
+export function backoffDelays(attempts: number, baseMs: number): number[] {
+  const delays: number[] = [];
+  for (let i = 0; i < attempts; i++) {
+    delays.push(Math.min(baseMs * 2 ** i, MAX_DELAY_MS));
+  }
+  return delays;
+}
diff --git a/test/cli/retry.test.ts b/test/cli/retry.test.ts
