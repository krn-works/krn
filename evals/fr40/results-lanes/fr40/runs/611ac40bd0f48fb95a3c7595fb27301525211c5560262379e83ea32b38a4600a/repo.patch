--- /dev/null
+++ b/test/cli/semver.test.ts
@@ -0,0 +1,25 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import { compareVersions } from '../../src/cli/semver.ts';
+
+describe('compareVersions', () => {
+  it('returns 0 for equal versions, ignoring trailing zero segments', () => {
+    assert.equal(compareVersions('1.2.3', '1.2.3'), 0);
+    assert.equal(compareVersions('1.2', '1.2.0'), 0);
+  });
+
+  it('orders numerically rather than lexically', () => {
+    assert.equal(compareVersions('1.10.0', '1.9.0'), 1);
+    assert.equal(compareVersions('1.9.0', '1.10.0'), -1);
+  });
+
+  it('orders versions with different segment counts', () => {
+    assert.equal(compareVersions('1.2', '1.2.1'), -1);
+    assert.equal(compareVersions('2', '1.9.9'), 1);
+  });
+
+  it('rejects non-numeric segments', () => {
+    assert.throws(() => compareVersions('1.x', '1.0'), TypeError);
+    assert.throws(() => compareVersions('', '1.0'), TypeError);
+  });
+});
