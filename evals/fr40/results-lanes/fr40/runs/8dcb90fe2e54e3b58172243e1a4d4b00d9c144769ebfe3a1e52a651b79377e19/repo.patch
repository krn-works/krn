@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { groupBy } from '../../src/cli/group-by.ts';
+
+test('group by keeps input order within and across groups', () => {
+  const groups = groupBy(['b1', 'a1', 'b2', 'a2'], (s) => s[0]);
+  assert.deepEqual([...groups], [
+    ['b', ['b1', 'b2']],
+    ['a', ['a1', 'a2']],
+  ]);
+});
+
+test('group by returns an empty map for no items', () => {
+  assert.equal(groupBy([], (s: string) => s).size, 0);
+});
