diff --git a/src/cli/semver.ts b/src/cli/semver.ts
new file mode 100644
index 0000000..1582f45
--- /dev/null
+++ b/src/cli/semver.ts
@@ -0,0 +1,22 @@
+/**
+ * Compare dotted numeric versions (e.g. "1.2.10" vs "1.3").
+ * Returns a negative number if a < b, positive if a > b, 0 if equal.
+ * Missing trailing segments count as 0, so "1.2" equals "1.2.0".
+ */
+export function compareVersions(a: string, b: string): number {
+  const pa = parse(a);
+  const pb = parse(b);
+  const len = Math.max(pa.length, pb.length);
+  for (let i = 0; i < len; i++) {
+    const diff = (pa[i] ?? 0) - (pb[i] ?? 0);
+    if (diff !== 0) return diff < 0 ? -1 : 1;
+  }
+  return 0;
+}
+
+function parse(v: string): number[] {
+  if (!/^\d+(\.\d+)*$/.test(v)) {
+    throw new TypeError(`invalid dotted numeric version: ${JSON.stringify(v)}`);
+  }
+  return v.split('.').map(Number);
+}
diff --git a/test/cli/semver.test.ts b/test/cli/semver.test.ts
new file mode 100644
index 0000000..754731c
--- /dev/null
+++ b/test/cli/semver.test.ts
@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { compareVersions } from '../../src/cli/semver.ts';
+
+test('orders numerically, not lexically', () => {
+  assert.equal(compareVersions('1.2.10', '1.2.9'), 1);
+  assert.equal(compareVersions('1.2.9', '1.2.10'), -1);
+  assert.equal(compareVersions('2.0.0', '10.0.0'), -1);
+});
+
+test('equal versions, with missing segments as zero', () => {
+  assert.equal(compareVersions('1.2.3', '1.2.3'), 0);
+  assert.equal(compareVersions('1.2', '1.2.0'), 0);
+  assert.equal(compareVersions('1.2.1', '1.2'), 1);
+});
+
+test('rejects non-numeric input', () => {
+  assert.throws(() => compareVersions('1.x', '1.0'), TypeError);
+  assert.throws(() => compareVersions('', '1.0'), TypeError);
+});
