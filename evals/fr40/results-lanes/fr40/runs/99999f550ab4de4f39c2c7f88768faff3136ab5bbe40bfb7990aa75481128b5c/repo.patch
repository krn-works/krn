+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderTable } from '../../src/cli/table.ts';
+
+test('pads columns to equal width', () => {
+  assert.equal(
+    renderTable([
+      ['id', 'status'],
+      ['t-1', 'open'],
+    ]),
+    'id   status\nt-1  open',
+  );
+});
+
+test('handles empty input and ragged rows', () => {
+  assert.equal(renderTable([]), '');
+  assert.equal(renderTable([['a', 'b'], ['long']]), 'a     b\nlong');
+});
