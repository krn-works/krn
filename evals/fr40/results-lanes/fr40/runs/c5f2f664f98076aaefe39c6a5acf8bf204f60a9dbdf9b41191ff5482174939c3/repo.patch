@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { formatDuration } from '../../src/cli/duration.ts';
+
+test('formats seconds only', () => {
+  assert.equal(formatDuration(0), '0s');
+  assert.equal(formatDuration(3000), '3s');
+});
+
+test('drops zero leading units', () => {
+  assert.equal(formatDuration(123000), '2m 3s');
+  assert.equal(formatDuration(3723000), '1h 2m 3s');
+});
+
+test('keeps interior zero units', () => {
+  assert.equal(formatDuration(3600000), '1h 0m 0s');
+});
+
+test('truncates sub-second and clamps negatives', () => {
+  assert.equal(formatDuration(1999), '1s');
+  assert.equal(formatDuration(-5), '0s');
+});
