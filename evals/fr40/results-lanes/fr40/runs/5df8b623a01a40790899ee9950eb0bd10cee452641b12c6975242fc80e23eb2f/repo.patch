@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { chunk } from '../../src/cli/chunk.ts';
+
+test('chunk splits a list into fixed-size groups', () => {
+  assert.deepEqual(chunk([1, 2, 3, 4], 2), [[1, 2], [3, 4]]);
+});
+
+test('chunk keeps a shorter final group', () => {
+  assert.deepEqual(chunk([1, 2, 3], 2), [[1, 2], [3]]);
+});
+
+test('chunk of an empty list is empty', () => {
+  assert.deepEqual(chunk([], 3), []);
+});
+
+test('chunk does not mutate its input', () => {
+  const items = [1, 2, 3];
+  chunk(items, 2);
+  assert.deepEqual(items, [1, 2, 3]);
+});
+
+test('chunk rejects a size below 1', () => {
+  assert.throws(() => chunk([1], 0), RangeError);
+  assert.throws(() => chunk([1], -1), RangeError);
+});
+
+test('chunk rejects a non-integer size', () => {
+  assert.throws(() => chunk([1], 1.5), RangeError);
+  assert.throws(() => chunk([1], Number.NaN), RangeError);
+});
