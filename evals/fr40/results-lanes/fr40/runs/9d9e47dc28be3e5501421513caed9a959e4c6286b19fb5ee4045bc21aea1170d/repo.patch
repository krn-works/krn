+/**
+ * Word-wraps `text` to lines of at most `width` characters. Words shorter than
+ * the width are never split; longer words are broken into width-sized chunks.
+ */
+export function wrapText(text: string, width: number): string[] {
+  const size = Math.max(1, Math.floor(width));
+  const lines: string[] = [];
+  let current = '';
+  for (const word of text.split(/\s+/).filter((w) => w.length > 0)) {
+    if (word.length > size) {
+      if (current) lines.push(current);
+      let rest = word;
+      while (rest.length > size) {
+        lines.push(rest.slice(0, size));
+        rest = rest.slice(size);
+      }
+      current = rest;
+    } else if (!current) {
+      current = word;
+    } else if (current.length + 1 + word.length <= size) {
+      current += ` ${word}`;
+    } else {
+      lines.push(current);
+      current = word;
+    }
+  }
+  if (current) lines.push(current);
+  return lines;
+}
