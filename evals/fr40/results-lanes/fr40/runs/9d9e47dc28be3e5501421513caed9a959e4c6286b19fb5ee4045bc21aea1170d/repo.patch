@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { wrapText } from '../../src/cli/wrap.ts';
+
+test('wraps at word boundaries', () => {
+  assert.deepEqual(wrapText('the quick brown fox', 10), [
+    'the quick',
+    'brown fox',
+  ]);
+});
+
+test('does not split words shorter than the width', () => {
+  assert.deepEqual(wrapText('aaaa bbbb cccc', 5), ['aaaa', 'bbbb', 'cccc']);
+});
+
+test('word equal to width stays whole', () => {
+  assert.deepEqual(wrapText('abcde f', 5), ['abcde', 'f']);
+});
+
+test('breaks words longer than the width', () => {
+  assert.deepEqual(wrapText('abcdefg hi', 3), ['abc', 'def', 'g', 'hi']);
+});
+
+test('empty text gives no lines', () => {
+  assert.deepEqual(wrapText('  ', 5), []);
+});
