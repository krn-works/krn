+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderTable } from '../../src/cli/table.ts';
+
+test('renderTable pads columns to equal width', () => {
+  assert.equal(
+    renderTable([
+      ['id', 'name'],
+      ['t-1', 'alpha'],
+      ['t-22222', 'b'],
+    ]),
+    ['id       name', 't-1      alpha', 't-22222  b'].join('\n'),
+  );
+});
+
+test('renderTable handles empty input and ragged rows', () => {
+  assert.equal(renderTable([]), '');
+  assert.equal(renderTable([['a', 'b', 'c'], ['dddd']]), 'a     b  c\ndddd');
+});
