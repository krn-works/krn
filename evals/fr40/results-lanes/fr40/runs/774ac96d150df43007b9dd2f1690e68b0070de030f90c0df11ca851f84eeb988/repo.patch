@@ -0,0 +1,18 @@
+// Plain-text table rendering: columns padded to equal width.
+export function renderTable(rows: readonly string[][]): string {
+  const widths: number[] = [];
+  for (const row of rows) {
+    row.forEach((cell, i) => {
+      widths[i] = Math.max(widths[i] ?? 0, cell.length);
+    });
+  }
+  return rows
+    .map((row) =>
+      row
+        .map((cell, i) =>
+          i === row.length - 1 ? cell : cell.padEnd(widths[i] ?? 0),
+        )
+        .join('  '),
+    )
+    .join('\n');
+}
