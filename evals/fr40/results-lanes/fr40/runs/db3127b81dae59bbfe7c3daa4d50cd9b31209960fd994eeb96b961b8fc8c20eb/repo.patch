Add parseRange to expand range lists like 1-3,5

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>


diff --git a/src/cli/range.ts b/src/cli/range.ts
new file mode 100644
index 0000000..f6537f2
--- /dev/null
+++ b/src/cli/range.ts
@@ -0,0 +1,14 @@
+/** Expands a range list such as `1-3,5` into `[1, 2, 3, 5]`. */
+export function parseRange(text: string): number[] {
+  const result: number[] = [];
+  for (const raw of text.split(',')) {
+    const part = raw.trim();
+    const match = /^(\d+)(?:-(\d+))?$/.exec(part);
+    if (!match) throw new Error(`Invalid range segment: "${part}"`);
+    const start = Number(match[1]);
+    const end = match[2] === undefined ? start : Number(match[2]);
+    if (end < start) throw new Error(`Descending range: "${part}"`);
+    for (let n = start; n <= end; n++) result.push(n);
+  }
+  return result;
+}
