@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRange } from '../../src/cli/range.ts';
+
+test('expands ranges and single values', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('accepts a single number and whitespace', () => {
+  assert.deepEqual(parseRange('7'), [7]);
+  assert.deepEqual(parseRange(' 1-2 , 4'), [1, 2, 4]);
+});
+
+test('rejects malformed input', () => {
+  assert.throws(() => parseRange(''), /Invalid range/);
+  assert.throws(() => parseRange('a-b'), /Invalid range/);
+  assert.throws(() => parseRange('1,,2'), /Invalid range/);
+});
+
+test('rejects descending ranges', () => {
+  assert.throws(() => parseRange('5-3'), /Descending/);
+});
