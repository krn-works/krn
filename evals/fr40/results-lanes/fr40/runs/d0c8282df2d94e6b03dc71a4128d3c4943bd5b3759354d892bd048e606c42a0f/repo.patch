@@ -0,0 +1,15 @@
+/** Expands `1-3,5` into `[1, 2, 3, 5]`. */
+export function parseRange(text: string): number[] {
+  return text
+    .split(',')
+    .map((part) => part.trim())
+    .filter(Boolean)
+    .flatMap((part) => {
+      const match = /^(\d+)(?:-(\d+))?$/.exec(part);
+      if (!match) throw new RangeError(`invalid range segment: ${part}`);
+      const start = Number(match[1]);
+      const end = Number(match[2] ?? match[1]);
+      if (end < start) throw new RangeError(`descending range: ${part}`);
+      return Array.from({ length: end - start + 1 }, (_, i) => start + i);
+    });
+}
