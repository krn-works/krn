@@ -0,0 +1,17 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRange } from '../../src/core/range.ts';
+
+test('expands ranges and single values', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('handles whitespace, single values and empty input', () => {
+  assert.deepEqual(parseRange(' 2 , 4-5 '), [2, 4, 5]);
+  assert.deepEqual(parseRange(''), []);
+});
+
+test('rejects malformed or descending segments', () => {
+  assert.throws(() => parseRange('a'), RangeError);
+  assert.throws(() => parseRange('3-1'), RangeError);
+});
