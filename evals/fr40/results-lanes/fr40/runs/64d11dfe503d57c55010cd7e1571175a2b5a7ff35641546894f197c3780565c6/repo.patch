+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { truncateMiddle } from '../src/core/truncate.ts';
+
+test('returns short text unchanged', () => {
+  assert.equal(truncateMiddle('hello', 5), 'hello');
+  assert.equal(truncateMiddle('hello', 10), 'hello');
+});
+
+test('keeps both ends around an ellipsis within max', () => {
+  assert.equal(truncateMiddle('abcdefghij', 5), 'ab…ij');
+  assert.equal(truncateMiddle('abcdefghij', 6), 'abc…ij');
+});
+
+test('handles tiny limits', () => {
+  assert.equal(truncateMiddle('abcdef', 1), '…');
+  assert.equal(truncateMiddle('abcdef', 0), '');
+});
