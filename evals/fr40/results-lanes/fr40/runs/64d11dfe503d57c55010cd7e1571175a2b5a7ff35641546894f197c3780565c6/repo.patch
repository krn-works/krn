Add truncateMiddle helper that keeps both ends around an ellipsis

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>


diff --git a/src/core/truncate.ts b/src/core/truncate.ts
new file mode 100644
index 0000000..2def013
--- /dev/null
+++ b/src/core/truncate.ts
@@ -0,0 +1,11 @@
+const ELLIPSIS = '…';
+
+// Keeps both ends of `text` around an ellipsis so the result is at most `max` characters.
+export function truncateMiddle(text: string, max: number): string {
+  if (text.length <= max) return text;
+  if (max <= 0) return '';
+  const keep = max - ELLIPSIS.length;
+  if (keep <= 0) return ELLIPSIS.slice(0, max);
+  const tail = Math.floor(keep / 2);
+  return text.slice(0, keep - tail) + ELLIPSIS + text.slice(text.length - tail);
+}
