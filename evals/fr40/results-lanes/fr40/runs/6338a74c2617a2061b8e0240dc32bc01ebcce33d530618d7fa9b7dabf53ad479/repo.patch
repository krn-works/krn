+++ b/test/cli/group-by.test.ts
@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { groupBy } from '../../src/cli/group-by.ts';
+
+test('group by keeps first-seen key order and input order within a group', () => {
+  const groups = groupBy(['bb', 'a', 'cc', 'd', 'ee'], (s) => String(s.length));
+  assert.deepEqual([...groups], [
+    ['2', ['bb', 'cc', 'ee']],
+    ['1', ['a', 'd']],
+  ]);
+});
+
+test('group by returns an empty map for no items', () => {
+  assert.equal(groupBy([], (s: string) => s).size, 0);
+});
