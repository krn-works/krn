+++ b/src/cli/group-by.ts
@@ -0,0 +1,14 @@
+/** Groups items by key, preserving input order across groups and within each group. */
+export function groupBy<T>(
+  items: readonly T[],
+  key: (item: T) => string,
+): Map<string, T[]> {
+  const groups = new Map<string, T[]>();
+  for (const item of items) {
+    const k = key(item);
+    const group = groups.get(k);
+    if (group) group.push(item);
+    else groups.set(k, [item]);
+  }
+  return groups;
+}
diff --git a/test/cli/group-by.test.ts b/test/cli/group-by.test.ts
new file mode 100644
