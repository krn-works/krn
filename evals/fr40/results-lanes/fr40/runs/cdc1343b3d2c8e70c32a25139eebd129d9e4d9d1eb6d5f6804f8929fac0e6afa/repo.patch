+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderTable } from '../../src/cli/table.ts';
+
+test('renderTable pads columns to equal width', () => {
+  const out = renderTable([
+    ['name', 'id'],
+    ['alpha', '1'],
+    ['b', '22'],
+  ]);
+  assert.equal(out, ['name   id', 'alpha  1', 'b      22'].join('\n'));
+});
+
+test('renderTable handles empty input and ragged rows', () => {
+  assert.equal(renderTable([]), '');
+  assert.equal(renderTable([['a', 'b'], ['ccc']]), 'a    b\nccc');
+});
