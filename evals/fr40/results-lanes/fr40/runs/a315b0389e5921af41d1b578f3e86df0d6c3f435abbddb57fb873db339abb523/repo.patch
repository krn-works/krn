@@ -0,0 +1,9 @@
+/** Lowercase, accent-free text with words joined by single hyphens. */
+export function slugify(text: string): string {
+  return text
+    .normalize('NFD')
+    .replace(/\p{M}+/gu, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-|-$/g, '');
+}
diff --git a/test/core/slug.test.ts b/test/core/slug.test.ts
