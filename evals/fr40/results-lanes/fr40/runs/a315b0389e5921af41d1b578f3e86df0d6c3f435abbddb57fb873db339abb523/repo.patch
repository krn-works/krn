+++ b/test/core/slug.test.ts
@@ -0,0 +1,15 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { slugify } from '../../src/core/slug.ts';
+
+test('slugify lowercases and joins words with single hyphens', () => {
+  assert.equal(slugify('Hello   World'), 'hello-world');
+});
+
+test('slugify strips accents', () => {
+  assert.equal(slugify('Crème Brûlée à la'), 'creme-brulee-a-la');
+});
+
+test('slugify drops punctuation and edge hyphens', () => {
+  assert.equal(slugify('  --Hi, there!--  '), 'hi-there');
+});
