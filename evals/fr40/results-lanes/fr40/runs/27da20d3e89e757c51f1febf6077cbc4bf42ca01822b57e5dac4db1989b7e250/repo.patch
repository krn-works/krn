@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { slugify } from '../../src/cli/slug.ts';
+
+test('slugify lowercases and joins words with single hyphens', () => {
+  assert.equal(slugify('Hello   World'), 'hello-world');
+});
+
+test('slugify strips accents', () => {
+  assert.equal(slugify('Crème Brûlée à la Café'), 'creme-brulee-a-la-cafe');
+});
+
+test('slugify trims separators and punctuation', () => {
+  assert.equal(slugify('  --Hi, there!--  '), 'hi-there');
+});
+
+test('slugify returns an empty string when nothing is left', () => {
+  assert.equal(slugify('!!!'), '');
+});
