@@ -0,0 +1,9 @@
+export function slugify(text: string): string {
+  return text
+    .normalize('NFD')
+    .replace(/\p{M}+/gu, '')
+    .toLowerCase()
+    .split(/[^a-z0-9]+/)
+    .filter(Boolean)
+    .join('-');
+}
diff --git a/test/cli/slug.test.ts b/test/cli/slug.test.ts
