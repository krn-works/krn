+++ b/src/cli/truncate.ts
@@ -0,0 +1,13 @@
+const ELLIPSIS = '…';
+
+/** Shorten text to at most `max` characters, keeping both ends around an ellipsis. */
+export function truncateMiddle(text: string, max: number): string {
+  const chars = Array.from(text);
+  if (chars.length <= max) return text;
+  if (max <= 0) return '';
+  if (max <= ELLIPSIS.length) return ELLIPSIS.slice(0, max);
+  const keep = max - ELLIPSIS.length;
+  const head = Math.ceil(keep / 2);
+  const tail = keep - head;
+  return chars.slice(0, head).join('') + ELLIPSIS + (tail > 0 ? chars.slice(chars.length - tail).join('') : '');
+}
