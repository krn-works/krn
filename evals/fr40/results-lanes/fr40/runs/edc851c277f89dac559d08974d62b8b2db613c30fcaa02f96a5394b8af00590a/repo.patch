@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { slugify } from '../../src/cli/slug.ts';
+
+test('slugify lowercases and joins words with hyphens', () => {
+  assert.equal(slugify('Hello World'), 'hello-world');
+});
+
+test('slugify strips accents', () => {
+  assert.equal(slugify('Café Crème Brûlée'), 'cafe-creme-brulee');
+});
+
+test('slugify collapses repeated separators and trims the ends', () => {
+  assert.equal(slugify('  a -- b__c  '), 'a-b-c');
+});
+
+test('slugify returns an empty string when no words remain', () => {
+  assert.equal(slugify(' !? '), '');
+  assert.equal(slugify(''), '');
+});
