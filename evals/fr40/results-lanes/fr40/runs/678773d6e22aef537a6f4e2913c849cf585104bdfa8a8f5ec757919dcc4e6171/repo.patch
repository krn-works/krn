+++ b/src/cli/bytes.ts
@@ -0,0 +1,12 @@
+const UNITS = ['B', 'KiB', 'MiB', 'GiB'];
+
+// Renders a byte count with the largest fitting unit and one decimal.
+export function formatBytes(n: number): string {
+  let value = n;
+  let unit = 0;
+  while (Math.abs(value) >= 1024 && unit < UNITS.length - 1) {
+    value /= 1024;
+    unit += 1;
+  }
+  return `${value.toFixed(1)} ${UNITS[unit]}`;
+}
diff --git a/test/cli/bytes.test.ts b/test/cli/bytes.test.ts
