+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { percent } from '../../src/cli/percent.ts';
+
+test('percent renders one decimal', () => {
+  assert.equal(percent(1, 3), '33.3%');
+  assert.equal(percent(1, 2), '50.0%');
+  assert.equal(percent(5, 5), '100.0%');
+  assert.equal(percent(0, 4), '0.0%');
+});
+
+test('percent returns 0.0% for a zero total', () => {
+  assert.equal(percent(0, 0), '0.0%');
+  assert.equal(percent(3, 0), '0.0%');
+});
