@@ -0,0 +1,24 @@
+/**
+ * Orders dotted numeric versions such as `1.2.10` against `1.2.9`.
+ * Returns a negative number when `a` is lower, positive when higher, 0 when
+ * equal. Missing trailing parts count as zero, so `1.2` equals `1.2.0`.
+ */
+export function compareVersions(a: string, b: string): number {
+  const left = parts(a);
+  const right = parts(b);
+  const length = Math.max(left.length, right.length);
+  for (let i = 0; i < length; i++) {
+    const diff = (left[i] ?? 0) - (right[i] ?? 0);
+    if (diff !== 0) return Math.sign(diff);
+  }
+  return 0;
+}
+
+function parts(version: string): number[] {
+  return version.split('.').map((part) => {
+    if (!/^\d+$/.test(part)) {
+      throw new Error(`Invalid version: ${version}`);
+    }
+    return Number(part);
+  });
+}
diff --git a/test/cli/semver.test.ts b/test/cli/semver.test.ts
new file mode 100644
index 0000000..f056c2d
--- /dev/null
+++ b/test/cli/semver.test.ts
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { compareVersions } from '../../src/cli/semver.ts';
+
+test('compareVersions compares parts numerically, not lexically', () => {
+  assert.equal(compareVersions('1.2.10', '1.2.9'), 1);
+  assert.equal(compareVersions('1.2.9', '1.2.10'), -1);
+});
+
+test('compareVersions treats equal versions and missing trailing zeros as equal', () => {
+  assert.equal(compareVersions('1.2.3', '1.2.3'), 0);
+  assert.equal(compareVersions('1.2', '1.2.0'), 0);
+});
+
+test('compareVersions orders by the most significant part first', () => {
+  assert.equal(compareVersions('2.0', '1.99.99'), 1);
+  assert.equal(compareVersions('1.0.1', '1.1'), -1);
+});
+
+test('compareVersions rejects non-numeric parts', () => {
+  assert.throws(() => compareVersions('1.x', '1.0'), /Invalid version/);
+  assert.throws(() => compareVersions('1.0', ''), /Invalid version/);
+});
