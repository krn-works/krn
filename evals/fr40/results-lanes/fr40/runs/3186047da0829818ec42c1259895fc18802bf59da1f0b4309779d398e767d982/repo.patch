+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderTable } from '../../src/cli/table.ts';
+
+test('render table pads columns to equal width', () => {
+  assert.equal(
+    renderTable([
+      ['name', 'id'],
+      ['a', '12345'],
+    ]),
+    'name  id\na     12345',
+  );
+});
+
+test('render table of no rows is empty', () => {
+  assert.equal(renderTable([]), '');
+});
