+export const MAX_BACKOFF_MS = 30_000;
+
+/** Doubling delays (baseMs, 2*baseMs, ...) capped at 30 seconds. */
+export function backoffDelays(attempts: number, baseMs: number): number[] {
+  if (!Number.isInteger(attempts) || attempts < 0) {
+    throw new RangeError(
+      `attempts must be a non-negative integer: ${attempts}`,
+    );
+  }
+  if (!Number.isFinite(baseMs) || baseMs < 0) {
+    throw new RangeError(
+      `baseMs must be a non-negative finite number: ${baseMs}`,
+    );
+  }
+  const delays: number[] = [];
+  let delay = Math.min(baseMs, MAX_BACKOFF_MS);
+  for (let i = 0; i < attempts; i++) {
+    delays.push(delay);
+    delay = Math.min(delay * 2, MAX_BACKOFF_MS);
+  }
+  return delays;
+}
