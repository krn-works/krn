+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { backoffDelays } from '../../src/cli/retry.ts';
+
+test('doubles from the base delay', () => {
+  assert.deepEqual(backoffDelays(4, 100), [100, 200, 400, 800]);
+});
+
+test('caps delays at 30 seconds', () => {
+  assert.deepEqual(
+    backoffDelays(5, 10_000),
+    [10_000, 20_000, 30_000, 30_000, 30_000],
+  );
+  assert.deepEqual(backoffDelays(2, 100_000), [30_000, 30_000]);
+});
+
+test('returns no delays for zero attempts', () => {
+  assert.deepEqual(backoffDelays(0, 100), []);
+});
+
+test('handles a zero base', () => {
+  assert.deepEqual(backoffDelays(3, 0), [0, 0, 0]);
+});
+
+test('rejects invalid input', () => {
+  assert.throws(() => backoffDelays(-1, 100), RangeError);
+  assert.throws(() => backoffDelays(1.5, 100), RangeError);
+  assert.throws(() => backoffDelays(2, -5), RangeError);
+  assert.throws(() => backoffDelays(2, Number.NaN), RangeError);
+});
