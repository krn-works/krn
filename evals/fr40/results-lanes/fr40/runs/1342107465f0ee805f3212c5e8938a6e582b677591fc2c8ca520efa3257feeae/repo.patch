@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { formatDuration } from '../../src/cli/duration.ts';
+
+test('duration renders hours, minutes and seconds', () => {
+  assert.equal(formatDuration(3_723_000), '1h 2m 3s');
+});
+
+test('duration drops zero leading units', () => {
+  assert.equal(formatDuration(123_000), '2m 3s');
+  assert.equal(formatDuration(3_000), '3s');
+});
+
+test('duration keeps zero inner units after a leading unit', () => {
+  assert.equal(formatDuration(3_600_000), '1h 0m 0s');
+});
+
+test('duration renders zero, fractions and negatives as seconds', () => {
+  assert.equal(formatDuration(0), '0s');
+  assert.equal(formatDuration(999), '0s');
+  assert.equal(formatDuration(-5), '0s');
+});
