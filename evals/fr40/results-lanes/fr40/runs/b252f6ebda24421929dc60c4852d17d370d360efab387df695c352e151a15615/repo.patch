+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderTable } from '../../src/core/table.ts';
+
+test('pads columns to equal width', () => {
+  assert.equal(
+    renderTable([
+      ['id', 'name'],
+      ['1', 'alpha'],
+      ['long-id', 'b'],
+    ]),
+    'id       name\n1        alpha\nlong-id  b',
+  );
+});
+
+test('handles empty input and ragged rows', () => {
+  assert.equal(renderTable([]), '');
+  assert.equal(renderTable([['a', 'b'], ['ccc']]), 'a    b\nccc');
+});
