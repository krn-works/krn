@@ -0,0 +1,5 @@
+export function clamp(value: number, min: number, max: number): number {
+  if (min > max)
+    throw new RangeError(`clamp: min (${min}) must not exceed max (${max})`);
+  return Math.min(Math.max(value, min), max);
+}
diff --git a/test/cli/clamp.test.ts b/test/cli/clamp.test.ts
new file mode 100644
index 0000000..c3da63e
--- /dev/null
+++ b/test/cli/clamp.test.ts
@@ -0,0 +1,20 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { clamp } from '../../src/cli/clamp.ts';
+
+test('clamp returns value inside the range', () => {
+  assert.equal(clamp(5, 0, 10), 5);
+});
+
+test('clamp limits values below min and above max', () => {
+  assert.equal(clamp(-1, 0, 10), 0);
+  assert.equal(clamp(11, 0, 10), 10);
+});
+
+test('clamp accepts equal bounds', () => {
+  assert.equal(clamp(3, 2, 2), 2);
+});
+
+test('clamp rejects min greater than max', () => {
+  assert.throws(() => clamp(1, 10, 0), RangeError);
+});
