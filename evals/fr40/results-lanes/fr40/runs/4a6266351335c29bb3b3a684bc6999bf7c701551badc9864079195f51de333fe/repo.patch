+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRange } from '../../src/cli/range.ts';
+
+test('expands ranges and single numbers', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('accepts a single number and surrounding spaces', () => {
+  assert.deepEqual(parseRange('7'), [7]);
+  assert.deepEqual(parseRange(' 2 - 4 , 6 '), [2, 3, 4, 6]);
+});
+
+test('rejects malformed or descending segments', () => {
+  assert.throws(() => parseRange(''), /Invalid range/);
+  assert.throws(() => parseRange('a-b'), /Invalid range/);
+  assert.throws(() => parseRange('3-1'), /Invalid range/);
+});
