@@ -0,0 +1,22 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { countLines } from '../../src/cli/count-lines.ts';
+
+test('count lines returns zero for empty text', () => {
+  assert.equal(countLines(''), 0);
+});
+
+test('count lines counts text without a trailing newline', () => {
+  assert.equal(countLines('a'), 1);
+  assert.equal(countLines('a\nb'), 2);
+});
+
+test('count lines ignores a single trailing newline', () => {
+  assert.equal(countLines('a\n'), 1);
+  assert.equal(countLines('a\nb\n'), 2);
+});
+
+test('count lines counts blank lines', () => {
+  assert.equal(countLines('\n'), 1);
+  assert.equal(countLines('a\n\n'), 2);
+});
