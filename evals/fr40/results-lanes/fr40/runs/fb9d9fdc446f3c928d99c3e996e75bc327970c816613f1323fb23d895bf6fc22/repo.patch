+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { parseRange } from '../../src/core/range.ts';
+
+test('expands ranges and single numbers', () => {
+  assert.deepEqual(parseRange('1-3,5'), [1, 2, 3, 5]);
+});
+
+test('accepts a single number and surrounding spaces', () => {
+  assert.deepEqual(parseRange(' 4 '), [4]);
+  assert.deepEqual(parseRange('1 - 2, 7'), [1, 2, 7]);
+});
+
+test('rejects malformed and descending segments', () => {
+  assert.throws(() => parseRange('a'), /Invalid range/);
+  assert.throws(() => parseRange('1,,2'), /Invalid range/);
+  assert.throws(() => parseRange('3-1'), /Descending/);
+});
