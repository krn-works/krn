+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { dedupeBy } from '../../src/cli/dedupe.ts';
+
+test('keeps the first item per key in order', () => {
+  const items = [
+    { id: 'a', n: 1 },
+    { id: 'b', n: 2 },
+    { id: 'a', n: 3 },
+  ];
+  assert.deepEqual(
+    dedupeBy(items, (i) => i.id),
+    [
+      { id: 'a', n: 1 },
+      { id: 'b', n: 2 },
+    ],
+  );
+});
+
+test('returns an empty array for empty input', () => {
+  assert.deepEqual(dedupeBy([], String), []);
+});
+
+test('does not mutate the input', () => {
+  const items = ['x', 'x'];
+  dedupeBy(items, (s) => s);
+  assert.deepEqual(items, ['x', 'x']);
+});
