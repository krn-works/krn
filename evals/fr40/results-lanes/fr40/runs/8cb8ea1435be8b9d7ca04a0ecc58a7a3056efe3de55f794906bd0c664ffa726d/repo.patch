+++ b/src/cli/truncate.ts
@@ -0,0 +1,21 @@
+const ELLIPSIS = '…';
+
+/**
+ * Shortens text to at most `max` characters, keeping the start and end
+ * around an ellipsis. The head gets the extra character when the kept
+ * length is odd. Text that already fits is returned unchanged.
+ */
+export function truncateMiddle(text: string, max: number): string {
+  const chars = Array.from(text);
+  const limit = Math.max(0, Math.floor(max));
+  if (chars.length <= limit) return text;
+  if (limit <= ELLIPSIS.length) return ELLIPSIS.slice(0, limit);
+  const keep = limit - ELLIPSIS.length;
+  const head = Math.ceil(keep / 2);
+  const tail = keep - head;
+  return (
+    chars.slice(0, head).join('') +
+    ELLIPSIS +
+    chars.slice(chars.length - tail).join('')
+  );
+}
