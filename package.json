{
  "name": "krn",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "bin": {
    "krn": "src/cli/krn.mjs"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "fast": "node scripts/fast-check.ts",
    "lint": "biome check --error-on-warnings . && node scripts/boundaries.ts",
    "test": "node scripts/test-suite.mjs",
    "render:agents": "node scripts/render-agents.ts --write",
    "rules": "node scripts/render-agents.ts --check",
    "gate": "npm run check && npm run lint && KRN_TEST_OUTPUT=failures npm test && node src/cli/main.ts task check && npm run rules",
    "context:report": "node scripts/claude/context-report.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.6.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
