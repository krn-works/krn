{
  "name": "krn",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "bin": {
    "krn": "src/cli/main.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "biome check .",
    "test": "node scripts/test-suite.mjs",
    "live": "node scripts/delivery-live.mjs",
    "live:smoke": "node scripts/live-smoke.mjs",
    "render:agents": "node scripts/render-agents.ts --write",
    "rules": "node scripts/render-agents.ts --check",
    "gate": "npm run check && npm run lint && npm test && node src/cli/main.ts task check && npm run rules",
    "gate:local": "node scripts/gate-local.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.6.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
