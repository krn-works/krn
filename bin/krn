#!/usr/bin/env bash
set -euo pipefail

source_path=${BASH_SOURCE[0]}
while [[ -L "$source_path" ]]; do
  source_dir=$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)
  target=$(readlink "$source_path")
  if [[ "$target" != /* ]]; then
    target="$source_dir/$target"
  fi
  source_path=$target
done

root=$(cd -P "$(dirname "$source_path")/.." >/dev/null 2>&1 && pwd)
if [[ ! -f "$root/.node-version" ]]; then
  printf 'krn: invalid .node-version: expected one Node version (for example 24.22.1).\n' >&2
  exit 65
fi

version_lines=()
mapfile -t version_lines < "$root/.node-version"
if [[ ${#version_lines[@]} -ne 1 ]]; then
  printf 'krn: invalid .node-version: expected one Node version (for example 24.22.1).\n' >&2
  exit 65
fi

version=${version_lines[0]}
version=${version#$'\xef\xbb\xbf'}
version=${version#"${version%%[!$' \t\r']*}"}
version=${version%"${version##*[!$' \t\r']}"}
if [[ ! "$version" =~ ^v?([0-9]+\.[0-9]+\.[0-9]+)$ ]]; then
  printf 'krn: invalid .node-version: expected one Node version (for example 24.22.1).\n' >&2
  exit 65
fi
version=${BASH_REMATCH[1]}
node=${MISE_DATA_DIR:-$HOME/.local/share/mise}/installs/node/$version/bin/node

if [[ ! -x "$node" ]]; then
  if install=$(mise where "node@$version" 2>/dev/null); then
    node="$install/bin/node"
  else
    node=
  fi
fi

if [[ ! -x "$node" ]]; then
  printf 'krn: Node.js %s is not installed; install it with mise.\n' "$version" >&2
  exit 127
fi

# Children (npm, observers, deliver) inherit the pinned toolchain, also when
# they re-activate mise from a bash child.
export MISE_NODE_VERSION=$version
PATH="$(dirname "$node"):$PATH"

go_pin_file="$root/infra/ci/mise.toml"
if [[ -f "$go_pin_file" ]]; then
  go_version=$(sed -n 's/^go[[:space:]]*=[[:space:]]*"\([0-9][0-9.]*\)"[[:space:]]*$/\1/p' "$go_pin_file" | head -n 1)
  if [[ -n "$go_version" ]]; then
    go_bin=${MISE_DATA_DIR:-$HOME/.local/share/mise}/installs/go/$go_version/bin
    if [[ ! -x "$go_bin/go" ]] && install=$(mise where "go@$go_version" 2>/dev/null); then
      go_bin="$install/bin"
    fi
    if [[ -x "$go_bin/go" ]]; then
      export MISE_GO_VERSION=$go_version
      PATH="$go_bin:$PATH"
    fi
  fi
fi
export PATH

exec "$node" "$root/src/cli/krn.mjs" "$@"
