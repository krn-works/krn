[
  {
    "id": "s-finish-gate-worker-stop",
    "type": "standard",
    "area": "finish-gate",
    "layer": "krn-delivery",
    "audience": "worker",
    "tier": "floor",
    "text": "KRN's own Stop hook runs `src/hook/stop.ts` (the gate `krn hook stop` runs in adopted repositories), which refuses the end of a session while the related tests are red.",
    "why": "A gate that lets a session end on an unrun or red test turns a broken tree into a delivered one.",
    "applies": {
      "stacks": [],
      "needs": [],
      "paths": [],
      "terms": [
        "finish",
        "gate",
        "worker",
        "stop",
        "lets",
        "unrun",
        "test",
        "turns",
        "broken",
        "tree",
        "delivered",
        "adopted",
        "repositories",
        "refuses"
      ]
    },
    "enforcement": {
      "kind": "command",
      "run": "node -e \"const s=JSON.parse(require('fs').readFileSync('.claude/settings.json','utf8'));const e=((s.hooks||{}).Stop)||[];const c=e.flatMap(x=>[x.command,...((x.hooks||[]).map(h=>h.command))]).filter(x=>typeof x==='string');process.exit(c.some(x=>/src\\/hook\\/stop\\.ts/.test(x))?0:1)\""
    },
    "provenance": {
      "origin": "project",
      "evidence": ["src/hook/stop.ts"],
      "proposals": []
    },
    "status": "accepted",
    "recorded_at": "2026-11-13",
    "valid_from": "2026-11-13",
    "valid_to": null,
    "supersedes": []
  },
